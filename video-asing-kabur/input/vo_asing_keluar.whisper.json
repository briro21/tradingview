[{"start": 0.0, "end": 6.02, "text": "Bayangkan besok pagi kamu buka aplikasi saham, dan semua investor asing sudah pergi.", "words": [[0.0, 0.82, "Bayangkan"], [0.82, 1.2, "besok"], [1.2, 1.62, "pagi"], [1.62, 1.86, "kamu"], [1.86, 2.14, "buka"], [2.14, 2.62, "aplikasi"], [2.62, 3.3, "saham,"], [3.5, 4.22, "dan"], [4.22, 4.5, "semua"], [4.5, 4.88, "investor"], [4.88, 5.3, "asing"], [5.3, 5.52, "sudah"], [5.52, 6.02, "pergi."]]}, {"start": 6.74, "end": 8.92, "text": "Gak ada satu pun yang tersisa.", "words": [[6.74, 7.02, "Gak"], [7.02, 7.38, "ada"], [7.38, 7.78, "satu"], [7.78, 8.22, "pun"], [8.22, 8.36, "yang"], [8.36, 8.92, "tersisa."]]}, {"start": 9.78, "end": 14.2, "text": "Apa yang terjadi sama uangmu, sama hargami instan, bahkan sama pekerjaanmu.", "words": [[9.78, 9.96, "Apa"], [9.96, 10.1, "yang"], [10.1, 10.4, "terjadi"], [10.4, 10.58, "sama"], [10.58, 11.22, "uangmu,"], [11.6, 11.68, "sama"], [11.68, 12.04, "hargami"], [12.04, 12.56, "instan,"], [12.88, 13.3, "bahkan"], [13.3, 13.46, "sama"], [13.46, 14.2, "pekerjaanmu."]]}, {"start": 14.54, "end": 16.3, "text": "Dan ini bukan hayalan total.", "words": [[14.54, 14.74, "Dan"], [14.74, 15.14, "ini"], [15.14, 15.46, "bukan"], [15.46, 15.9, "hayalan"], [15.9, 16.3, "total."]]}, {"start": 16.98, "end": 24.24, "text": "Tahun ini, IHSG sudah turun sekitar 40 persen, jadi yang terburuk dari 35 bursa dunia.", "words": [[16.98, 17.28, "Tahun"], [17.28, 17.6, "ini,"], [17.84, 18.42, "IHSG"], [18.42, 18.66, "sudah"], [18.66, 19.16, "turun"], [19.16, 19.46, "sekitar"], [19.46, 20.14, "40"], [20.14, 20.62, "persen,"], [20.88, 21.24, "jadi"], [21.24, 21.48, "yang"], [21.48, 22.22, "terburuk"], [22.22, 22.42, "dari"], [22.42, 23.12, "35"], [23.12, 23.84, "bursa"], [23.84, 24.24, "dunia."]]}, {"start": 24.76, "end": 30.24, "text": "Pada 16 Oktober, indeks sempat anjok lebih dari 11 persen, dalam 1 hari.", "words": [[24.76, 25.12, "Pada"], [25.12, 25.46, "16"], [25.46, 25.98, "Oktober,"], [26.26, 26.6, "indeks"], [26.6, 26.92, "sempat"], [26.92, 27.3, "anjok"], [27.3, 27.82, "lebih"], [27.82, 28.08, "dari"], [28.08, 28.42, "11"], [28.42, 28.86, "persen,"], [29.04, 29.42, "dalam"], [29.42, 29.8, "1"], [29.8, 30.24, "hari."]]}, {"start": 30.7, "end": 33.4, "text": "Asing pun terus jual, triliunan rupiah.", "words": [[30.7, 31.08, "Asing"], [31.08, 31.22, "pun"], [31.22, 31.58, "terus"], [31.58, 31.98, "jual,"], [32.28, 32.98, "triliunan"], [32.98, 33.4, "rupiah."]]}, {"start": 33.94, "end": 37.82, "text": "Di video ini, kita jalani skenario terburuknya, hari demi hari.", "words": [[33.94, 34.08, "Di"], [34.08, 34.36, "video"], [34.36, 34.6, "ini,"], [34.76, 34.92, "kita"], [34.92, 35.32, "jalani"], [35.32, 35.78, "skenario"], [35.78, 36.54, "terburuknya,"], [36.78, 37.14, "hari"], [37.14, 37.44, "demi"], [37.44, 37.82, "hari."]]}, {"start": 38.2, "end": 44.66, "text": "Tapi tumbuh sampai akhir, karena ada satu kejadian aneh minggu ini yang mengubah cara kamu melihat semua ini.", "words": [[38.2, 38.46, "Tapi"], [38.46, 38.94, "tumbuh"], [38.94, 39.14, "sampai"], [39.14, 39.54, "akhir,"], [39.86, 40.12, "karena"], [40.12, 40.38, "ada"], [40.38, 40.78, "satu"], [40.78, 41.2, "kejadian"], [41.2, 41.68, "aneh"], [41.68, 41.94, "minggu"], [41.94, 42.26, "ini"], [42.26, 42.6, "yang"], [42.6, 43.1, "mengubah"], [43.1, 43.32, "cara"], [43.32, 43.64, "kamu"], [43.64, 44.08, "melihat"], [44.08, 44.32, "semua"], [44.32, 44.66, "ini."]]}, {"start": 44.86, "end": 47.12, "text": "Pertama, kenapa asing sepenting itu?", "words": [[44.86, 45.24, "Pertama,"], [45.72, 46.04, "kenapa"], [46.04, 46.42, "asing"], [46.42, 46.78, "sepenting"], [46.78, 47.12, "itu?"]]}, {"start": 47.56, "end": 50.28, "text": "Bayangkan pasar saham seperti pasar tradisional.", "words": [[47.56, 48.08, "Bayangkan"], [48.08, 48.38, "pasar"], [48.38, 48.9, "saham"], [48.9, 49.14, "seperti"], [49.14, 49.5, "pasar"], [49.5, 50.28, "tradisional."]]}, {"start": 50.28, "end": 57.4, "text": "Saham-saham besar seperti BBCA, BBRI, dan TLKM, itu seperti lapak paling ramai.", "words": [[50.28, 51.06, "Saham"], [51.06, 51.3, "-saham"], [51.3, 51.58, "besar"], [51.58, 52.0, "seperti"], [52.0, 53.04, "BBCA,"], [53.48, 53.98, "BBRI,"], [54.46, 54.52, "dan"], [54.52, 55.44, "TLKM,"], [55.56, 55.84, "itu"], [55.84, 56.12, "seperti"], [56.12, 56.62, "lapak"], [56.62, 56.88, "paling"], [56.88, 57.4, "ramai."]]}, {"start": 57.6, "end": 60.26, "text": "Dan sebagian pembelinya adalah investor asing.", "words": [[57.6, 58.02, "Dan"], [58.02, 58.42, "sebagian"], [58.42, 58.96, "pembelinya"], [58.96, 59.42, "adalah"], [59.42, 59.76, "investor"], [59.76, 60.26, "asing."]]}, {"start": 60.62, "end": 64.82, "text": "Kalau pembeli besar tiba-tiba hilang, siapa yang bayar harga lapaknya?", "words": [[60.62, 60.96, "Kalau"], [60.96, 61.36, "pembeli"], [61.36, 61.7, "besar"], [61.7, 61.94, "tiba"], [61.94, 62.16, "-tiba"], [62.16, 62.82, "hilang,"], [63.24, 63.68, "siapa"], [63.68, 63.84, "yang"], [63.84, 64.1, "bayar"], [64.1, 64.32, "harga"], [64.32, 64.82, "lapaknya?"]]}, {"start": 65.26, "end": 66.78, "text": "Itulah awal masalahnya.", "words": [[65.26, 65.84, "Itulah"], [65.84, 66.14, "awal"], [66.14, 66.78, "masalahnya."]]}, {"start": 67.24, "end": 69.1, "text": "Sekarang, kita mulai skenario-nya.", "words": [[67.24, 67.8, "Sekarang,"], [67.96, 68.14, "kita"], [68.14, 68.44, "mulai"], [68.44, 68.78, "skenario"], [68.78, 69.1, "-nya."]]}, {"start": 69.42, "end": 71.82, "text": "Siapkan diri, karena jatuhnya bertahap.", "words": [[69.42, 69.8, "Siapkan"], [69.8, 70.14, "diri,"], [70.32, 70.6, "karena"], [70.6, 71.18, "jatuhnya"], [71.18, 71.82, "bertahap."]]}, {"start": 72.08, "end": 74.64, "text": "Hari pertama, pukul 9 pagi, bursa dibuka.", "words": [[72.08, 72.28, "Hari"], [72.28, 72.58, "pertama,"], [73.02, 73.24, "pukul"], [73.24, 73.46, "9"], [73.46, 73.9, "pagi,"], [74.14, 74.34, "bursa"], [74.34, 74.64, "dibuka."]]}, {"start": 75.0, "end": 77.68, "text": "Semua investor asing menekan tombol jual bersamaan.", "words": [[75.0, 75.22, "Semua"], [75.22, 75.5, "investor"], [75.5, 75.84, "asing"], [75.84, 76.14, "menekan"], [76.14, 76.4, "tombol"], [76.4, 76.7, "jual"], [76.7, 77.68, "bersamaan."]]}, {"start": 78.18, "end": 79.42, "text": "Antrian jual menumpuk.", "words": [[78.18, 78.56, "Antrian"], [78.56, 78.88, "jual"], [78.88, 79.42, "menumpuk."]]}, {"start": 79.74, "end": 82.36, "text": "Harga turun, lalu terkena batas auto reject bawah.", "words": [[79.74, 80.0, "Harga"], [80.0, 80.36, "turun,"], [80.52, 80.76, "lalu"], [80.76, 81.04, "terkena"], [81.04, 81.34, "batas"], [81.34, 81.6, "auto"], [81.6, 81.88, "reject"], [81.88, 82.36, "bawah."]]}, {"start": 82.56, "end": 85.24, "text": "Satu saham, dua saham, lalu hampir semuanya.", "words": [[82.56, 82.88, "Satu"], [82.88, 83.22, "saham,"], [83.44, 83.58, "dua"], [83.58, 84.0, "saham,"], [84.22, 84.36, "lalu"], [84.36, 84.82, "hampir"], [84.82, 85.24, "semuanya."]]}, {"start": 85.72, "end": 86.78, "text": "Layar jadi merah total.", "words": [[85.72, 86.04, "Layar"], [86.04, 86.24, "jadi"], [86.24, 86.46, "merah"], [86.46, 86.78, "total."]]}, {"start": 87.28, "end": 89.12, "text": "Bursa bisa menghentikan perdagangan sementara.", "words": [[87.28, 87.66, "Bursa"], [87.66, 87.8, "bisa"], [87.8, 88.2, "menghentikan"], [88.2, 88.64, "perdagangan"], [88.64, 89.12, "sementara."]]}, {"start": 89.68, "end": 91.5, "text": "Tapi ini baru pemanasan.", "words": [[89.68, 90.1, "Tapi"], [90.1, 90.56, "ini"], [90.56, 90.78, "baru"], [90.78, 91.5, "pemanasan."]]}, {"start": 91.84, "end": 94.68, "text": "Soalnya uang hasil penjualan itu tidak diam disini.", "words": [[91.84, 92.32, "Soalnya"], [92.32, 92.76, "uang"], [92.76, 93.0, "hasil"], [93.0, 93.48, "penjualan"], [93.48, 93.72, "itu"], [93.72, 93.94, "tidak"], [93.94, 94.28, "diam"], [94.28, 94.68, "disini."]]}, {"start": 95.2, "end": 98.36, "text": "Dan disinilah masalah yang sebenarnya dimulai.", "words": [[95.2, 95.48, "Dan"], [95.48, 96.14, "disinilah"], [96.14, 96.9, "masalah"], [96.9, 97.12, "yang"], [97.12, 97.76, "sebenarnya"], [97.76, 98.36, "dimulai."]]}, {"start": 98.78, "end": 99.92, "text": "Satu minggu kemudian.", "words": [[98.78, 99.12, "Satu"], [99.12, 99.4, "minggu"], [99.4, 99.92, "kemudian."]]}, {"start": 100.56, "end": 103.86, "text": "Investor asing menerima rupiah dari hasil jual saham.", "words": [[100.56, 101.06, "Investor"], [101.06, 101.48, "asing"], [101.48, 101.88, "menerima"], [101.88, 102.34, "rupiah"], [102.34, 102.66, "dari"], [102.66, 103.08, "hasil"], [103.08, 103.3, "jual"], [103.3, 103.86, "saham."]]}, {"start": 104.0, "end": 106.74, "text": "Tapi mereka butuh dolar untuk dibawa pulang.", "words": [[104.0, 104.68, "Tapi"], [104.68, 105.08, "mereka"], [105.08, 105.44, "butuh"], [105.44, 105.82, "dolar"], [105.82, 106.04, "untuk"], [106.04, 106.32, "dibawa"], [106.32, 106.74, "pulang."]]}, {"start": 107.16, "end": 111.76, "text": "Jadi mereka menukar rupiah ke dolar dalam jumlah raksasa.", "words": [[107.16, 107.58, "Jadi"], [107.58, 108.02, "mereka"], [108.02, 108.5, "menukar"], [108.5, 108.92, "rupiah"], [108.92, 109.12, "ke"], [109.12, 109.64, "dolar"], [109.64, 110.3, "dalam"], [110.3, 110.98, "jumlah"], [110.98, 111.76, "raksasa."]]}, {"start": 112.16, "end": 117.12, "text": "Hasilnya, rupiah ditinggal banyak orang dan nilainya melemah tajam.", "words": [[112.16, 112.96, "Hasilnya,"], [113.32, 113.8, "rupiah"], [113.8, 114.32, "ditinggal"], [114.32, 114.78, "banyak"], [114.78, 115.14, "orang"], [115.14, 115.5, "dan"], [115.5, 116.08, "nilainya"], [116.08, 116.52, "melemah"], [116.52, 117.12, "tajam."]]}, {"start": 117.56, "end": 121.1, "text": "Dan sekarang ini bukan lagi cuma urusan orang yang main saham.", "words": [[117.56, 117.74, "Dan"], [117.74, 118.22, "sekarang"], [118.22, 118.86, "ini"], [118.86, 119.08, "bukan"], [119.08, 119.4, "lagi"], [119.4, 119.58, "cuma"], [119.58, 119.94, "urusan"], [119.94, 120.24, "orang"], [120.24, 120.44, "yang"], [120.44, 120.6, "main"], [120.6, 121.1, "saham."]]}, {"start": 121.54, "end": 123.68, "text": "Ini mulai menyentuh dompet semua orang.", "words": [[121.54, 121.8, "Ini"], [121.8, 122.08, "mulai"], [122.08, 122.5, "menyentuh"], [122.5, 123.0, "dompet"], [123.0, 123.26, "semua"], [123.26, 123.68, "orang."]]}, {"start": 124.3, "end": 127.66, "text": "Termasuk kamu yang gak punya satu lembar saham pun.", "words": [[124.3, 124.78, "Termasuk"], [124.78, 125.24, "kamu"], [125.24, 125.84, "yang"], [125.84, 126.02, "gak"], [126.02, 126.44, "punya"], [126.44, 126.78, "satu"], [126.78, 127.08, "lembar"], [127.08, 127.5, "saham"], [127.5, 127.66, "pun."]]}, {"start": 128.12, "end": 129.28, "text": "Satu bulan kemudian.", "words": [[128.12, 128.5, "Satu"], [128.5, 128.78, "bulan"], [128.78, 129.28, "kemudian."]]}, {"start": 129.86, "end": 132.76, "text": "Rupiah yang lemah membuat barang impor jadi mahal.", "words": [[129.86, 130.3, "Rupiah"], [130.3, 130.48, "yang"], [130.48, 130.92, "lemah"], [130.92, 131.3, "membuat"], [131.3, 131.58, "barang"], [131.58, 131.98, "impor"], [131.98, 132.18, "jadi"], [132.18, 132.76, "mahal."]]}, {"start": 133.4, "end": 138.3, "text": "BBM, gandum, elektronik, bahkan bahan baku yang dipakai pabrik Mi Instan.", "words": [[133.4, 134.02, "BBM,"], [134.36, 134.84, "gandum,"], [135.12, 135.76, "elektronik,"], [135.96, 136.38, "bahkan"], [136.38, 136.64, "bahan"], [136.64, 136.94, "baku"], [136.94, 137.04, "yang"], [137.04, 137.4, "dipakai"], [137.4, 137.68, "pabrik"], [137.68, 137.84, "Mi"], [137.84, 138.3, "Instan."]]}, {"start": 138.72, "end": 140.4, "text": "Harga diwarung mulai naik.", "words": [[138.72, 139.28, "Harga"], [139.28, 139.68, "diwarung"], [139.68, 139.94, "mulai"], [139.94, 140.4, "naik."]]}, {"start": 140.8, "end": 144.32, "text": "Bang Indonesia mungkin terpaksa menaikkan suku bunga untuk menahan rupiah.", "words": [[140.8, 141.04, "Bang"], [141.04, 141.4, "Indonesia"], [141.4, 141.76, "mungkin"], [141.76, 142.44, "terpaksa"], [142.44, 142.82, "menaikkan"], [142.82, 143.02, "suku"], [143.02, 143.42, "bunga"], [143.42, 143.58, "untuk"], [143.58, 143.86, "menahan"], [143.86, 144.32, "rupiah."]]}, {"start": 144.96, "end": 148.02, "text": "Bunga naik berarti cicilan kredit juga bisa ikut naik.", "words": [[144.96, 145.24, "Bunga"], [145.24, 145.66, "naik"], [145.66, 146.18, "berarti"], [146.18, 146.52, "cicilan"], [146.52, 146.92, "kredit"], [146.92, 147.16, "juga"], [147.16, 147.34, "bisa"], [147.34, 147.56, "ikut"], [147.56, 148.02, "naik."]]}, {"start": 149.1, "end": 151.94, "text": "Dan kalau kamu pikir ini sudah paling buruk.", "words": [[149.1, 149.5, "Dan"], [149.5, 149.82, "kalau"], [149.82, 150.04, "kamu"], [150.04, 150.48, "pikir"], [150.48, 150.82, "ini"], [150.82, 151.06, "sudah"], [151.06, 151.4, "paling"], [151.4, 151.94, "buruk."]]}, {"start": 152.54, "end": 153.06, "text": "Belum.", "words": [[152.54, 153.06, "Belum."]]}, {"start": 153.62, "end": 154.94, "text": "Satu tahun kemudian.", "words": [[153.62, 154.0, "Satu"], [154.0, 154.28, "tahun"], [154.28, 154.94, "kemudian."]]}, {"start": 155.68, "end": 160.34, "text": "Perusahaan yang biasanya cari modal lewat Bursa mendapatkan pintunya tertutup.", "words": [[155.68, 156.4, "Perusahaan"], [156.4, 156.5, "yang"], [156.5, 156.94, "biasanya"], [156.94, 157.24, "cari"], [157.24, 157.46, "modal"], [157.46, 157.8, "lewat"], [157.8, 158.42, "Bursa"], [158.42, 159.18, "mendapatkan"], [159.18, 159.6, "pintunya"], [159.6, 160.34, "tertutup."]]}, {"start": 160.78, "end": 161.8, "text": "Expansi berhenti.", "words": [[160.78, 161.38, "Expansi"], [161.38, 161.8, "berhenti."]]}, {"start": 162.4, "end": 163.76, "text": "Recruitment dibekukan.", "words": [[162.4, 162.98, "Recruitment"], [162.98, 163.76, "dibekukan."]]}, {"start": 164.14, "end": 166.34, "text": "Beberapa startup kehabisan nafas.", "words": [[164.14, 164.7, "Beberapa"], [164.7, 165.14, "startup"], [165.14, 165.7, "kehabisan"], [165.7, 166.34, "nafas."]]}, {"start": 166.9, "end": 170.06, "text": "Satu persatu lampu kantor padam.", "words": [[166.9, 167.42, "Satu"], [167.42, 168.12, "persatu"], [168.12, 169.02, "lampu"], [169.02, 169.4, "kantor"], [169.4, 170.06, "padam."]]}, {"start": 171.38, "end": 173.5, "text": "Itu sken hario terburuknya.", "words": [[171.38, 171.84, "Itu"], [171.84, 172.52, "sken"], [172.52, 172.78, "hario"], [172.78, 173.5, "terburuknya."]]}, {"start": 174.96, "end": 180.26, "text": "Tapi sekarang saya harus kasih tahu sesuatu yang gak masuk akal.", "words": [[174.96, 175.88, "Tapi"], [175.88, 176.8, "sekarang"], [176.8, 177.4, "saya"], [177.4, 177.64, "harus"], [177.64, 177.88, "kasih"], [177.88, 178.14, "tahu"], [178.14, 178.66, "sesuatu"], [178.66, 178.98, "yang"], [178.98, 179.44, "gak"], [179.44, 179.68, "masuk"], [179.68, 180.26, "akal."]]}, {"start": 180.52, "end": 182.4, "text": "Ingat kejadian aneh yang saya janjikan tadi?", "words": [[180.52, 180.8, "Ingat"], [180.8, 181.1, "kejadian"], [181.1, 181.46, "aneh"], [181.46, 181.6, "yang"], [181.6, 181.74, "saya"], [181.74, 182.06, "janjikan"], [182.06, 182.4, "tadi?"]]}, {"start": 182.82, "end": 183.28, "text": "Ini dia.", "words": [[182.82, 183.06, "Ini"], [183.06, 183.28, "dia."]]}, {"start": 183.82, "end": 188.74, "text": "Pada 20 Oktober asing jual sekitar 2,21 triliun rupiah.", "words": [[183.82, 184.02, "Pada"], [184.02, 184.46, "20"], [184.46, 185.12, "Oktober"], [185.12, 185.72, "asing"], [185.72, 186.0, "jual"], [186.0, 186.36, "sekitar"], [186.36, 186.8, "2"], [186.8, 187.62, ",21"], [187.62, 188.34, "triliun"], [188.34, 188.74, "rupiah."]]}, {"start": 189.22, "end": 193.32, "text": "Tapi di hari yang sama, IHS dia justru naik lebih dari 5%.", "words": [[189.22, 189.6, "Tapi"], [189.6, 189.82, "di"], [189.82, 189.94, "hari"], [189.94, 190.1, "yang"], [190.1, 190.44, "sama,"], [190.84, 191.24, "IHS"], [191.24, 191.5, "dia"], [191.5, 191.78, "justru"], [191.78, 192.16, "naik"], [192.16, 192.4, "lebih"], [192.4, 192.58, "dari"], [192.58, 193.32, "5%."]]}, {"start": 193.32, "end": 194.24, "text": "Kok bisa?", "words": [[193.32, 193.88, "Kok"], [193.88, 194.24, "bisa?"]]}, {"start": 194.84, "end": 196.06, "text": "Karena ada yang membeli.", "words": [[194.84, 195.16, "Karena"], [195.16, 195.42, "ada"], [195.42, 195.56, "yang"], [195.56, 196.06, "membeli."]]}, {"start": 196.5, "end": 203.3, "text": "Investor Rokal, ribuan orang biasa dan institusi dalam netri menahan indek supaya tidak jatuh lebih dalam.", "words": [[196.5, 197.0, "Investor"], [197.0, 197.54, "Rokal,"], [197.88, 198.32, "ribuan"], [198.32, 198.52, "orang"], [198.52, 199.04, "biasa"], [199.04, 199.38, "dan"], [199.38, 200.0, "institusi"], [200.0, 200.24, "dalam"], [200.24, 200.64, "netri"], [200.64, 201.28, "menahan"], [201.28, 201.76, "indek"], [201.76, 202.1, "supaya"], [202.1, 202.48, "tidak"], [202.48, 202.82, "jatuh"], [202.82, 203.0, "lebih"], [203.0, 203.3, "dalam."]]}, {"start": 203.7, "end": 206.88, "text": "Artinya sken hario tadi tidak otomatis terjadi.", "words": [[203.7, 204.36, "Artinya"], [204.36, 205.06, "sken"], [205.06, 205.3, "hario"], [205.3, 205.68, "tadi"], [205.68, 205.9, "tidak"], [205.9, 206.36, "otomatis"], [206.36, 206.88, "terjadi."]]}, {"start": 207.3, "end": 210.46, "text": "Pasar ini punya penahan yang selama ini sering kita lupakan.", "words": [[207.3, 207.68, "Pasar"], [207.68, 207.88, "ini"], [207.88, 208.12, "punya"], [208.12, 208.54, "penahan"], [208.54, 208.82, "yang"], [208.82, 209.18, "selama"], [209.18, 209.4, "ini"], [209.4, 209.84, "sering"], [209.84, 210.04, "kita"], [210.04, 210.46, "lupakan."]]}, {"start": 210.96, "end": 213.48, "text": "Sekarang pertanyaan yang lebih menarik.", "words": [[210.96, 211.72, "Sekarang"], [211.72, 212.48, "pertanyaan"], [212.48, 212.58, "yang"], [212.58, 212.78, "lebih"], [212.78, 213.48, "menarik."]]}, {"start": 213.94, "end": 216.0, "text": "Kalau asing benar-benar kabur.", "words": [[213.94, 214.22, "Kalau"], [214.22, 214.7, "asing"], [214.7, 215.02, "benar"], [215.02, 215.28, "-benar"], [215.28, 216.0, "kabur."]]}, {"start": 216.52, "end": 217.4, "text": "Siapa yang untung?", "words": [[216.52, 216.9, "Siapa"], [216.9, 217.04, "yang"], [217.04, 217.4, "untung?"]]}, {"start": 217.94, "end": 220.04, "text": "Saham bagus bisa dijual sangat murah.", "words": [[217.94, 218.3, "Saham"], [218.3, 218.66, "bagus"], [218.66, 218.96, "bisa"], [218.96, 219.32, "dijual"], [219.32, 219.56, "sangat"], [219.56, 220.04, "murah."]]}, {"start": 220.32, "end": 225.46, "text": "Mereka yang punya uang tunai dan sabar bisa jadi pemilik baru perusahaan terbesar di Indonesia.", "words": [[220.32, 220.76, "Mereka"], [220.76, 220.9, "yang"], [220.9, 221.12, "punya"], [221.12, 221.36, "uang"], [221.36, 221.7, "tunai"], [221.7, 221.86, "dan"], [221.86, 222.38, "sabar"], [222.38, 222.68, "bisa"], [222.68, 222.96, "jadi"], [222.96, 223.28, "pemilik"], [223.28, 223.66, "baru"], [223.66, 224.26, "perusahaan"], [224.26, 224.9, "terbesar"], [224.9, 225.08, "di"], [225.08, 225.46, "Indonesia."]]}, {"start": 226.06, "end": 229.58, "text": "Tapi hati-hati, harga murah belum tentu kesempatan.", "words": [[226.06, 226.4, "Tapi"], [226.4, 226.76, "hati"], [226.76, 227.0, "-hati,"], [227.58, 227.9, "harga"], [227.9, 228.36, "murah"], [228.36, 228.6, "belum"], [228.6, 228.92, "tentu"], [228.92, 229.58, "kesempatan."]]}, {"start": 229.96, "end": 231.62, "text": "Kadang murah itu jebakan.", "words": [[229.96, 230.52, "Kadang"], [230.52, 230.92, "murah"], [230.92, 231.08, "itu"], [231.08, 231.62, "jebakan."]]}, {"start": 232.08, "end": 235.18, "text": "Karena saham yang turun bisa saja turun lebih jauh lagi.", "words": [[232.08, 232.3, "Karena"], [232.3, 232.64, "saham"], [232.64, 232.78, "yang"], [232.78, 233.26, "turun"], [233.26, 233.54, "bisa"], [233.54, 233.9, "saja"], [233.9, 234.44, "turun"], [234.44, 234.62, "lebih"], [234.62, 234.86, "jauh"], [234.86, 235.18, "lagi."]]}, {"start": 235.68, "end": 238.44, "text": "Ini yang membedakan investor dari penjudi.", "words": [[235.68, 235.98, "Ini"], [235.98, 236.24, "yang"], [236.24, 236.68, "membedakan"], [236.68, 237.3, "investor"], [237.3, 237.84, "dari"], [237.84, 238.44, "penjudi."]]}, {"start": 238.64, "end": 243.12, "text": "Jadi menurut kamu asing kabur itu kiamat atau kesempatan?", "words": [[238.64, 238.98, "Jadi"], [238.98, 239.58, "menurut"], [239.58, 239.92, "kamu"], [239.92, 240.64, "asing"], [240.64, 240.96, "kabur"], [240.96, 241.2, "itu"], [241.2, 242.16, "kiamat"], [242.16, 242.42, "atau"], [242.42, 243.12, "kesempatan?"]]}, {"start": 243.52, "end": 244.84, "text": "Tulis jawabanmu di komentar.", "words": [[243.52, 243.88, "Tulis"], [243.88, 244.36, "jawabanmu"], [244.36, 244.46, "di"], [244.46, 244.84, "komentar."]]}, {"start": 245.18, "end": 246.8, "text": "Saya baca satu persatu.", "words": [[245.18, 245.34, "Saya"], [245.34, 245.8, "baca"], [245.8, 246.3, "satu"], [246.3, 246.8, "persatu."]]}, {"start": 246.8, "end": 253.18, "text": "Dan kalau kamu penasaran apa yang terjadi kalau rupiah benar-benar jatuh ke 20 ribu rupiah per dolar,", "words": [[246.8, 247.42, "Dan"], [247.42, 247.7, "kalau"], [247.7, 247.9, "kamu"], [247.9, 248.42, "penasaran"], [248.42, 248.84, "apa"], [248.84, 249.02, "yang"], [249.02, 249.46, "terjadi"], [249.46, 249.7, "kalau"], [249.7, 250.08, "rupiah"], [250.08, 250.56, "benar"], [250.56, 250.88, "-benar"], [250.88, 251.22, "jatuh"], [251.22, 251.32, "ke"], [251.32, 251.94, "20"], [251.94, 252.24, "ribu"], [252.24, 252.54, "rupiah"], [252.54, 252.68, "per"], [252.68, 253.18, "dolar,"]]}, {"start": 253.46, "end": 255.12, "text": "videonya ada di layar sekarang.", "words": [[253.46, 254.0, "videonya"], [254.0, 254.34, "ada"], [254.34, 254.5, "di"], [254.5, 254.74, "layar"], [254.74, 255.12, "sekarang."]]}, {"start": 255.32, "end": 256.14, "text": "Sampai jumpa di sana.", "words": [[255.32, 255.64, "Sampai"], [255.64, 255.88, "jumpa"], [255.88, 255.96, "di"], [255.96, 256.14, "sana."]]}, {"start": 256.52, "end": 259.56, "text": "Video ini bukan ajakan untuk membeli atau menjual saham.", "words": [[256.52, 256.78, "Video"], [256.78, 257.04, "ini"], [257.04, 257.28, "bukan"], [257.28, 257.76, "ajakan"], [257.76, 257.96, "untuk"], [257.96, 258.5, "membeli"], [258.5, 258.72, "atau"], [258.72, 259.14, "menjual"], [259.14, 259.56, "saham."]]}]