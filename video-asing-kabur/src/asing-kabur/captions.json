[
{
"start": 0.0,
"end": 3.3,
"text": "Bayangkan besok pagi kamu buka aplikasi saham,"
},
{
"start": 3.5,
"end": 6.02,
"text": "dan semua investor asing sudah pergi."
},
{
"start": 6.74,
"end": 8.92,
"text": "Gak ada satu pun yang tersisa."
},
{
"start": 9.78,
"end": 11.68,
"text": "Apa yang terjadi sama uangmu, sama"
},
{
"start": 11.68,
"end": 14.2,
"text": "harga mi instan, bahkan sama pekerjaanmu."
},
{
"start": 14.54,
"end": 16.3,
"text": "Dan ini bukan khayalan total."
},
{
"start": 16.98,
"end": 19.16,
"text": "Tahun ini, IHSG sudah turun"
},
{
"start": 19.16,
"end": 21.48,
"text": "sekitar 40 persen, jadi yang"
},
{
"start": 21.48,
"end": 24.24,
"text": "terburuk dari 35 bursa dunia."
},
{
"start": 24.76,
"end": 27.82,
"text": "Pada 16 Oktober, indeks sempat anjlok lebih"
},
{
"start": 27.82,
"end": 30.24,
"text": "dari 11 persen, dalam 1 hari."
},
{
"start": 30.7,
"end": 33.4,
"text": "Asing pun terus jual, triliunan rupiah."
},
{
"start": 33.94,
"end": 35.32,
"text": "Di video ini, kita jalani"
},
{
"start": 35.32,
"end": 37.82,
"text": "skenario terburuknya, hari demi hari."
},
{
"start": 38.2,
"end": 40.38,
"text": "Tapi tonton sampai akhir, karena ada"
},
{
"start": 40.38,
"end": 42.6,
"text": "satu kejadian aneh minggu ini yang"
},
{
"start": 42.6,
"end": 44.66,
"text": "mengubah cara kamu melihat semua ini."
},
{
"start": 44.86,
"end": 47.12,
"text": "Pertama, kenapa asing sepenting itu?"
},
{
"start": 47.56,
"end": 50.28,
"text": "Bayangkan pasar saham seperti pasar tradisional."
},
{
"start": 50.28,
"end": 53.98,
"text": "Saham-saham besar seperti BBCA, BBRI, dan"
},
{
"start": 54.46,
"end": 57.4,
"text": "TLKM, itu seperti lapak paling ramai."
},
{
"start": 57.6,
"end": 60.26,
"text": "Dan sebagian pembelinya adalah investor asing."
},
{
"start": 60.62,
"end": 62.82,
"text": "Kalau pembeli besar tiba-tiba hilang,"
},
{
"start": 63.24,
"end": 64.82,
"text": "siapa yang bayar harga lapaknya?"
},
{
"start": 65.26,
"end": 66.78,
"text": "Itulah awal masalahnya."
},
{
"start": 67.24,
"end": 69.1,
"text": "Sekarang, kita mulai skenarionya."
},
{
"start": 69.42,
"end": 71.82,
"text": "Siapkan diri, karena jatuhnya bertahap."
},
{
"start": 72.08,
"end": 74.64,
"text": "Hari pertama, pukul 9 pagi, bursa dibuka."
},
{
"start": 75.0,
"end": 77.68,
"text": "Semua investor asing menekan tombol jual bersamaan."
},
{
"start": 78.18,
"end": 79.42,
"text": "Antrean jual menumpuk."
},
{
"start": 79.74,
"end": 81.04,
"text": "Harga turun, lalu terkena"
},
{
"start": 81.04,
"end": 82.36,
"text": "batas auto reject bawah."
},
{
"start": 82.56,
"end": 85.24,
"text": "Satu saham, dua saham, lalu hampir semuanya."
},
{
"start": 85.72,
"end": 86.78,
"text": "Layar jadi merah total."
},
{
"start": 87.28,
"end": 89.12,
"text": "Bursa bisa menghentikan perdagangan sementara."
},
{
"start": 89.68,
"end": 91.5,
"text": "Tapi ini baru pemanasan."
},
{
"start": 91.84,
"end": 93.48,
"text": "Soalnya uang hasil penjualan itu"
},
{
"start": 93.48,
"end": 94.68,
"text": "tidak diam di sini."
},
{
"start": 95.2,
"end": 98.36,
"text": "Dan di sinilah masalah yang sebenarnya dimulai."
},
{
"start": 98.78,
"end": 99.92,
"text": "Satu minggu kemudian."
},
{
"start": 100.56,
"end": 102.34,
"text": "Investor asing menerima rupiah"
},
{
"start": 102.34,
"end": 103.86,
"text": "dari hasil jual saham."
},
{
"start": 104.0,
"end": 106.74,
"text": "Tapi mereka butuh dolar untuk dibawa pulang."
},
{
"start": 107.16,
"end": 109.12,
"text": "Jadi mereka menukar rupiah ke"
},
{
"start": 109.12,
"end": 111.76,
"text": "dolar dalam jumlah raksasa."
},
{
"start": 112.16,
"end": 115.14,
"text": "Hasilnya, rupiah ditinggal banyak orang"
},
{
"start": 115.14,
"end": 117.12,
"text": "dan nilainya melemah tajam."
},
{
"start": 117.56,
"end": 119.58,
"text": "Dan sekarang ini bukan lagi cuma"
},
{
"start": 119.58,
"end": 121.1,
"text": "urusan orang yang main saham."
},
{
"start": 121.54,
"end": 123.68,
"text": "Ini mulai menyentuh dompet semua orang."
},
{
"start": 124.3,
"end": 126.44,
"text": "Termasuk kamu yang gak punya"
},
{
"start": 126.44,
"end": 127.66,
"text": "satu lembar saham pun."
},
{
"start": 128.12,
"end": 129.28,
"text": "Satu bulan kemudian."
},
{
"start": 129.86,
"end": 131.3,
"text": "Rupiah yang lemah membuat"
},
{
"start": 131.3,
"end": 132.76,
"text": "barang impor jadi mahal."
},
{
"start": 133.4,
"end": 136.94,
"text": "BBM, gandum, elektronik, bahkan bahan baku"
},
{
"start": 136.94,
"end": 138.3,
"text": "yang dipakai pabrik mi instan."
},
{
"start": 138.72,
"end": 140.4,
"text": "Harga di warung mulai naik."
},
{
"start": 140.8,
"end": 142.82,
"text": "Bank Indonesia mungkin terpaksa menaikkan"
},
{
"start": 142.82,
"end": 144.32,
"text": "suku bunga untuk menahan rupiah."
},
{
"start": 144.96,
"end": 146.92,
"text": "Bunga naik berarti cicilan kredit"
},
{
"start": 146.92,
"end": 148.02,
"text": "juga bisa ikut naik."
},
{
"start": 149.1,
"end": 150.48,
"text": "Dan kalau kamu pikir"
},
{
"start": 150.48,
"end": 151.94,
"text": "ini sudah paling buruk."
},
{
"start": 152.54,
"end": 153.06,
"text": "Belum."
},
{
"start": 153.62,
"end": 154.94,
"text": "Satu tahun kemudian."
},
{
"start": 155.68,
"end": 157.46,
"text": "Perusahaan yang biasanya cari modal"
},
{
"start": 157.46,
"end": 160.34,
"text": "lewat bursa mendapati pintunya tertutup."
},
{
"start": 160.78,
"end": 161.8,
"text": "Ekspansi berhenti."
},
{
"start": 162.4,
"end": 163.76,
"text": "Rekrutmen dibekukan."
},
{
"start": 164.14,
"end": 166.34,
"text": "Beberapa startup kehabisan napas."
},
{
"start": 166.9,
"end": 170.06,
"text": "Satu per satu lampu kantor padam."
},
{
"start": 171.38,
"end": 173.5,
"text": "Itu skenario terburuknya."
},
{
"start": 174.96,
"end": 178.14,
"text": "Tapi sekarang saya harus kasih tahu"
},
{
"start": 178.14,
"end": 180.26,
"text": "sesuatu yang gak masuk akal."
},
{
"start": 180.52,
"end": 182.4,
"text": "Ingat kejadian aneh yang saya janjikan tadi?"
},
{
"start": 182.82,
"end": 183.28,
"text": "Ini dia."
},
{
"start": 183.82,
"end": 186.36,
"text": "Pada 20 Oktober asing jual"
},
{
"start": 186.36,
"end": 188.74,
"text": "sekitar 2,21 triliun rupiah."
},
{
"start": 189.22,
"end": 191.5,
"text": "Tapi di hari yang sama, IHSG"
},
{
"start": 191.5,
"end": 193.32,
"text": "justru naik lebih dari 5%."
},
{
"start": 193.32,
"end": 194.24,
"text": "Kok bisa?"
},
{
"start": 194.84,
"end": 196.06,
"text": "Karena ada yang membeli."
},
{
"start": 196.5,
"end": 199.38,
"text": "Investor lokal, ribuan orang biasa dan"
},
{
"start": 199.38,
"end": 202.1,
"text": "institusi dalam negeri menahan indeks supaya"
},
{
"start": 202.1,
"end": 203.3,
"text": "tidak jatuh lebih dalam."
},
{
"start": 203.7,
"end": 206.88,
"text": "Artinya skenario tadi tidak otomatis terjadi."
},
{
"start": 207.3,
"end": 208.82,
"text": "Pasar ini punya penahan yang"
},
{
"start": 208.82,
"end": 210.46,
"text": "selama ini sering kita lupakan."
},
{
"start": 210.96,
"end": 213.48,
"text": "Sekarang pertanyaan yang lebih menarik."
},
{
"start": 213.94,
"end": 216.0,
"text": "Kalau asing benar-benar kabur."
},
{
"start": 216.52,
"end": 217.4,
"text": "Siapa yang untung?"
},
{
"start": 217.94,
"end": 220.04,
"text": "Saham bagus bisa dijual sangat murah."
},
{
"start": 220.32,
"end": 221.7,
"text": "Mereka yang punya uang tunai"
},
{
"start": 221.7,
"end": 223.28,
"text": "dan sabar bisa jadi pemilik"
},
{
"start": 223.28,
"end": 225.46,
"text": "baru perusahaan terbesar di Indonesia."
},
{
"start": 226.06,
"end": 229.58,
"text": "Tapi hati-hati, harga murah belum tentu kesempatan."
},
{
"start": 229.96,
"end": 231.62,
"text": "Kadang murah itu jebakan."
},
{
"start": 232.08,
"end": 233.54,
"text": "Karena saham yang turun bisa"
},
{
"start": 233.54,
"end": 235.18,
"text": "saja turun lebih jauh lagi."
},
{
"start": 235.68,
"end": 238.44,
"text": "Ini yang membedakan investor dari penjudi."
},
{
"start": 238.64,
"end": 240.96,
"text": "Jadi menurut kamu asing kabur"
},
{
"start": 240.96,
"end": 243.12,
"text": "itu kiamat atau kesempatan?"
},
{
"start": 243.52,
"end": 244.84,
"text": "Tulis jawabanmu di komentar."
},
{
"start": 245.18,
"end": 246.8,
"text": "Saya baca satu per satu."
},
{
"start": 246.8,
"end": 249.02,
"text": "Dan kalau kamu penasaran apa yang"
},
{
"start": 249.02,
"end": 251.32,
"text": "terjadi kalau rupiah benar-benar jatuh ke"
},
{
"start": 251.32,
"end": 253.18,
"text": "20 ribu rupiah per dolar,"
},
{
"start": 253.46,
"end": 255.12,
"text": "videonya ada di layar sekarang."
},
{
"start": 255.32,
"end": 256.14,
"text": "Sampai jumpa di sana."
},
{
"start": 256.52,
"end": 257.96,
"text": "Video ini bukan ajakan untuk"
},
{
"start": 257.96,
"end": 259.56,
"text": "membeli atau menjual saham."
}
]