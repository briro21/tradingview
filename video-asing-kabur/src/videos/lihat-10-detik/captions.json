[
{
"start": 0.3,
"end": 2.19,
"text": "Jam sembilan pagi. Kamu"
},
{
"start": 2.19,
"end": 4.574,
"text": "menatap layar aplikasi saham."
},
{
"start": 5.024,
"end": 6.552,
"text": "Harga sebuah saham bank masih"
},
{
"start": 6.552,
"end": 7.659,
"text": "diam di angka seribu."
},
{
"start": 8.109,
"end": 10.185,
"text": "Tapi di matamu, angkanya"
},
{
"start": 10.185,
"end": 12.779,
"text": "sudah berubah. Seribu seratus."
},
{
"start": 13.229,
"end": 14.182,
"text": "Kamu tekan beli."
},
{
"start": 15.082,
"end": 17.646,
"text": "Sepuluh detik kemudian, harganya benar-benar"
},
{
"start": 17.646,
"end": 18.986,
"text": "naik ke seribu seratus."
},
{
"start": 19.436,
"end": 20.511,
"text": "Raka: Bro... kok kamu bisa"
},
{
"start": 20.511,
"end": 21.709,
"text": "beli pas banget sebelum naik?"
},
{
"start": 22.159,
"end": 24.04,
"text": "Kamu sendiri tidak tahu jawabannya."
},
{
"start": 24.49,
"end": 26.528,
"text": "Kamu cuma tahu satu hal. Sejak"
},
{
"start": 26.528,
"end": 28.907,
"text": "bangun tadi pagi, kamu bisa melihat"
},
{
"start": 28.907,
"end": 30.47,
"text": "sepuluh detik ke depan."
},
{
"start": 30.92,
"end": 33.1,
"text": "Jadi, bagaimana kalau kamu bisa melihat"
},
{
"start": 33.1,
"end": 35.169,
"text": "harga saham sepuluh detik lebih awal?"
},
{
"start": 35.619,
"end": 36.906,
"text": "Aturannya sederhana."
},
{
"start": 37.806,
"end": 39.88,
"text": "Kamu tidak bisa melihat besok."
},
{
"start": 39.88,
"end": 42.092,
"text": "Tidak bisa melihat minggu depan."
},
{
"start": 42.542,
"end": 45.429,
"text": "Hanya sepuluh detik. Tidak lebih."
},
{
"start": 45.879,
"end": 48.815,
"text": "Kedengarannya kecil. Tapi di pasar saham,"
},
{
"start": 48.815,
"end": 50.964,
"text": "sepuluh detik itu sangat lama."
},
{
"start": 51.414,
"end": 55.105,
"text": "Dalam sepuluh detik, ribuan order bisa masuk."
},
{
"start": 55.105,
"end": 58.305,
"text": "Harga bisa naik, turun, lalu naik lagi."
},
{
"start": 58.755,
"end": 61.313,
"text": "Trader biasa harus menebak. Kamu"
},
{
"start": 61.313,
"end": 63.792,
"text": "tidak perlu menebak. Kamu hanya"
},
{
"start": 63.792,
"end": 66.91,
"text": "perlu menunggu, melihat, lalu bergerak."
},
{
"start": 67.36,
"end": 69.526,
"text": "Hari pertama, kamu mulai kecil."
},
{
"start": 69.976,
"end": 71.744,
"text": "Modalmu cuma lima ratus ribu"
},
{
"start": 71.744,
"end": 73.26,
"text": "rupiah, sisa uang jajan."
},
{
"start": 73.71,
"end": 77.158,
"text": "Beli, tunggu sepuluh detik, jual."
},
{
"start": 77.158,
"end": 79.352,
"text": "Beli lagi, jual lagi."
},
{
"start": 79.802,
"end": 82.733,
"text": "Sore harinya, saldomu jadi enam ratus ribu."
},
{
"start": 83.183,
"end": 85.277,
"text": "Seratus ribu dalam sehari."
},
{
"start": 85.277,
"end": 87.211,
"text": "Tanpa satu pun kerugian."
},
{
"start": 87.661,
"end": 90.329,
"text": "Raka: Kamu pakai robot ya? Ajarin dong!"
},
{
"start": 90.779,
"end": 91.957,
"text": "Kamu cuma tersenyum."
},
{
"start": 92.857,
"end": 95.123,
"text": "Minggu pertama, kamu mulai berani."
},
{
"start": 95.573,
"end": 97.735,
"text": "Lima juta jadi tujuh juta."
},
{
"start": 97.735,
"end": 99.731,
"text": "Tujuh juta jadi sepuluh."
},
{
"start": 100.181,
"end": 102.366,
"text": "Kamu membayar uang kos tiga bulan"
},
{
"start": 102.366,
"end": 105.479,
"text": "sekaligus. Kamu mentraktir teman-temanmu makan."
},
{
"start": 105.929,
"end": 107.992,
"text": "Untuk pertama kalinya, kamu tidak lagi"
},
{
"start": 107.992,
"end": 110.055,
"text": "melihat harga sebelum memesan makanan."
},
{
"start": 110.505,
"end": 111.727,
"text": "Tapi ada satu hal aneh."
},
{
"start": 112.177,
"end": 114.548,
"text": "Semakin sering kamu memakai kemampuan ini,"
},
{
"start": 114.548,
"end": 117.032,
"text": "semakin dunia terasa seperti tayangan ulang."
},
{
"start": 117.482,
"end": 118.729,
"text": "Setiap kejutan sudah kamu"
},
{
"start": 118.729,
"end": 120.276,
"text": "lihat sepuluh detik sebelumnya."
},
{
"start": 120.726,
"end": 122.91,
"text": "Temanmu tertawa karena lelucon."
},
{
"start": 122.91,
"end": 125.095,
"text": "Kamu sudah mendengarnya duluan."
},
{
"start": 125.545,
"end": 128.139,
"text": "Bulan kedua, uangmu sudah ratusan juta."
},
{
"start": 128.589,
"end": 131.626,
"text": "Kamu membeli rumah untuk orang tuamu. Rumah"
},
{
"start": 131.626,
"end": 134.239,
"text": "kecil, tapi atapnya tidak bocor lagi."
},
{
"start": 134.689,
"end": 137.397,
"text": "Bu Ana: Nak, ini... uang dari mana?"
},
{
"start": 137.847,
"end": 141.064,
"text": "Kamu: Dari saham, Bu. Tenang saja."
},
{
"start": 141.514,
"end": 143.9,
"text": "Ibumu, Bu Ana, memelukmu."
},
{
"start": 143.9,
"end": 147.145,
"text": "Tapi matanya menyimpan pertanyaan."
},
{
"start": 147.595,
"end": 148.924,
"text": "Kabar tentang anak muda yang"
},
{
"start": 148.924,
"end": 150.49,
"text": "tidak pernah rugi mulai menyebar."
},
{
"start": 150.94,
"end": 153.809,
"text": "Akun media sosialmu tiba-tiba diikuti ribuan orang."
},
{
"start": 154.259,
"end": 156.482,
"text": "Raka: Bro, kamu viral! Ada yang nawarin"
},
{
"start": 156.482,
"end": 158.933,
"text": "kamu jadi admin grup sinyal saham berbayar!"
},
{
"start": 159.383,
"end": 163.236,
"text": "Kamu menolak. Kemampuanmu tidak bisa diajarkan. Dan"
},
{
"start": 163.236,
"end": 166.711,
"text": "menjual mimpi kepada orang lain rasanya salah."
},
{
"start": 167.161,
"end": 170.241,
"text": "Tapi tidak semua orang berpikir sepertimu. Dalam"
},
{
"start": 170.241,
"end": 173.449,
"text": "hitungan hari, muncul akun-akun palsu yang memakai"
},
{
"start": 173.449,
"end": 176.337,
"text": "namamu, menjanjikan untung pasti setiap hari."
},
{
"start": 176.787,
"end": 178.284,
"text": "Dan banyak orang yang percaya."
},
{
"start": 178.734,
"end": 180.543,
"text": "Dan di sinilah semuanya mulai rumit."
},
{
"start": 180.993,
"end": 183.574,
"text": "Di bursa saham, ada sistem yang terus"
},
{
"start": 183.574,
"end": 187.55,
"text": "mengawasi transaksi. Mereka menyebutnya pengawasan pasar."
},
{
"start": 188.0,
"end": 190.056,
"text": "Kalau ada pola yang terlalu sempurna,"
},
{
"start": 190.056,
"end": 192.278,
"text": "sistem itu akan menyalakan tanda bahaya."
},
{
"start": 192.728,
"end": 194.919,
"text": "Seribu transaksi. Tidak ada"
},
{
"start": 194.919,
"end": 196.462,
"text": "satu pun yang rugi."
},
{
"start": 196.912,
"end": 200.032,
"text": "Bagi sistem, itu bukan keberuntungan. Itu"
},
{
"start": 200.032,
"end": 202.391,
"text": "tanda sesuatu yang tidak wajar."
},
{
"start": 202.841,
"end": 205.157,
"text": "Suatu pagi, ponselmu berdering."
},
{
"start": 206.057,
"end": 208.279,
"text": "Petugas: Selamat pagi. Kami dari"
},
{
"start": 208.279,
"end": 210.64,
"text": "tim pengawasan. Kami ingin meminta"
},
{
"start": 210.64,
"end": 213.418,
"text": "penjelasan mengenai pola transaksi Anda."
},
{
"start": 213.868,
"end": 215.136,
"text": "Kamu duduk di ruangan putih"
},
{
"start": 215.136,
"end": 216.497,
"text": "dengan tiga orang di depanmu."
},
{
"start": 216.947,
"end": 218.617,
"text": "Petugas: Siapa yang memberi Anda informasi?"
},
{
"start": 219.067,
"end": 222.234,
"text": "Kamu: Tidak ada. Saya hanya... melihat grafik."
},
{
"start": 222.684,
"end": 225.074,
"text": "Petugas: Seribu transaksi tanpa rugi."
},
{
"start": 225.074,
"end": 226.882,
"text": "Anda ingin kami percaya itu?"
},
{
"start": 227.332,
"end": 233.048,
"text": "Mereka memeriksa ponselmu. Pesanmu. Rekeningmu. Tidak"
},
{
"start": 233.048,
"end": 236.824,
"text": "ada orang dalam. Tidak ada bocoran."
},
{
"start": 237.274,
"end": 239.69,
"text": "Tidak ada yang bisa mereka buktikan."
},
{
"start": 239.69,
"end": 241.77,
"text": "Tapi mereka juga tidak percaya."
},
{
"start": 242.22,
"end": 246.582,
"text": "Akunmu dibatasi. Setiap transaksimu sekarang diawasi."
},
{
"start": 247.032,
"end": 250.753,
"text": "Dan untuk pertama kalinya, kamu sadar: kemampuan"
},
{
"start": 250.753,
"end": 253.699,
"text": "ini bukan cuma hadiah. Ini juga beban."
},
{
"start": 254.149,
"end": 255.478,
"text": "Kamu mulai sulit tidur."
},
{
"start": 256.378,
"end": 260.824,
"text": "Setiap kali memejamkan mata, kamu melihat"
},
{
"start": 260.824,
"end": 265.271,
"text": "angka bergerak. Hijau. Merah. Hijau lagi."
},
{
"start": 265.721,
"end": 267.458,
"text": "Teman-temanmu mulai menjaga jarak."
},
{
"start": 268.358,
"end": 271.363,
"text": "Raka: Jujur deh. Kamu orang dalam, ya?"
},
{
"start": 271.813,
"end": 273.93,
"text": "Kamu tidak bisa menjelaskan."
},
{
"start": 273.93,
"end": 275.744,
"text": "Siapa yang akan percaya?"
},
{
"start": 276.194,
"end": 279.363,
"text": "Uangmu bertambah setiap hari. Tapi orang yang"
},
{
"start": 279.363,
"end": 282.11,
"text": "bisa kamu ajak bicara, semakin sedikit."
},
{
"start": 282.56,
"end": 283.749,
"text": "Lalu tibalah hari itu."
},
{
"start": 284.649,
"end": 287.315,
"text": "Pagi itu, pasar terlihat biasa saja."
},
{
"start": 287.765,
"end": 289.826,
"text": "Tapi tepat jam sepuluh lewat lima menit,"
},
{
"start": 289.826,
"end": 292.454,
"text": "kamu melihat sesuatu yang membuat tanganmu gemetar."
},
{
"start": 292.904,
"end": 294.521,
"text": "Dalam sepuluh detik ke depan,"
},
{
"start": 294.521,
"end": 296.361,
"text": "seluruh layar akan berubah merah."
},
{
"start": 296.811,
"end": 300.183,
"text": "Bukan satu saham. Hampir semuanya."
},
{
"start": 300.633,
"end": 303.126,
"text": "Sebuah berita buruk akan keluar."
},
{
"start": 303.126,
"end": 305.619,
"text": "Indeks akan anjlok. Antrean jual"
},
{
"start": 305.619,
"end": 308.189,
"text": "akan menumpuk sampai batas bawah."
},
{
"start": 308.639,
"end": 309.95,
"text": "Kamu punya sepuluh detik."
},
{
"start": 310.85,
"end": 313.836,
"text": "Pilihan pertama: jual semua milikmu sekarang."
},
{
"start": 313.836,
"end": 316.69,
"text": "Kamu akan menyelamatkan uangmu, bahkan bisa"
},
{
"start": 316.69,
"end": 319.012,
"text": "untung miliaran dari kejatuhan ini."
},
{
"start": 319.462,
"end": 321.916,
"text": "Pilihan kedua: peringatkan orang lain."
},
{
"start": 322.366,
"end": 323.982,
"text": "Dan di antara jutaan investor"
},
{
"start": 323.982,
"end": 325.543,
"text": "ritel yang akan terkena, ada"
},
{
"start": 325.543,
"end": 326.992,
"text": "satu nama yang kamu kenal."
},
{
"start": 327.442,
"end": 330.113,
"text": "Ayahmu. Pak Joko."
},
{
"start": 331.013,
"end": 333.278,
"text": "Seminggu lalu, Pak Joko memasukkan"
},
{
"start": 333.278,
"end": 335.742,
"text": "seluruh tabungan pensiunnya ke saham."
},
{
"start": 335.742,
"end": 338.007,
"text": "Karena dia melihat anaknya sukses."
},
{
"start": 338.457,
"end": 340.182,
"text": "Pak Joko: Kalau kamu bisa,"
},
{
"start": 340.182,
"end": 341.908,
"text": "Ayah juga pasti bisa, kan?"
},
{
"start": 342.358,
"end": 343.169,
"text": "Sembilan detik."
},
{
"start": 344.069,
"end": 347.179,
"text": "Kalau kamu menjual sekarang, kamu selamat. Tapi"
},
{
"start": 347.179,
"end": 349.958,
"text": "tidak ada waktu untuk menelepon siapa pun."
},
{
"start": 350.408,
"end": 351.14,
"text": "Delapan detik."
},
{
"start": 352.04,
"end": 353.875,
"text": "Kalau kamu menelepon ayahmu, kamu"
},
{
"start": 353.875,
"end": 355.933,
"text": "tidak sempat menjual milikmu sendiri."
},
{
"start": 356.383,
"end": 357.044,
"text": "Tujuh detik."
},
{
"start": 357.944,
"end": 361.673,
"text": "Kamu menekan satu tombol. Bukan tombol jual."
},
{
"start": 362.123,
"end": 363.057,
"text": "Tombol panggil."
},
{
"start": 363.957,
"end": 369.695,
"text": "Kamu: Yah! Jual sekarang! Semuanya! Jangan tanya!"
},
{
"start": 370.145,
"end": 372.455,
"text": "Pak Joko: Hah? Kenapa..."
},
{
"start": 373.355,
"end": 374.572,
"text": "Kamu: Sekarang, Yah!"
},
{
"start": 375.472,
"end": 379.544,
"text": "Tiga detik. Dua. Satu."
},
{
"start": 380.444,
"end": 381.603,
"text": "Layar berubah merah."
},
{
"start": 382.503,
"end": 384.635,
"text": "Pak Joko berhasil keluar tepat"
},
{
"start": 384.635,
"end": 387.123,
"text": "waktu. Tabungan pensiunnya selamat."
},
{
"start": 387.573,
"end": 390.993,
"text": "Tapi milikmu sendiri? Terjebak di antrean jual."
},
{
"start": 390.993,
"end": 394.339,
"text": "Hari itu, kamu kehilangan hampir setengah dari"
},
{
"start": 394.339,
"end": 396.667,
"text": "semua yang sudah kamu kumpulkan."
},
{
"start": 397.117,
"end": 401.949,
"text": "Kamu duduk di lantai kamar. Diam. Lama."
},
{
"start": 402.399,
"end": 406.07,
"text": "Lalu ponselmu bergetar. Pesan dari Pak Joko."
},
{
"start": 406.52,
"end": 409.628,
"text": "Pak Joko: Nak, Ayah tidak tahu bagaimana"
},
{
"start": 409.628,
"end": 412.659,
"text": "kamu bisa tahu. Tapi terima kasih. Kamu"
},
{
"start": 412.659,
"end": 415.768,
"text": "menyelamatkan masa tua Ayah dan Ibu Ana."
},
{
"start": 416.218,
"end": 418.12,
"text": "Malam itu, untuk pertama kalinya"
},
{
"start": 418.12,
"end": 420.557,
"text": "dalam berbulan-bulan, kamu tidur nyenyak."
},
{
"start": 421.007,
"end": 422.499,
"text": "Kamu baru sadar sesuatu."
},
{
"start": 423.399,
"end": 425.478,
"text": "Selama ini kamu bisa melihat sepuluh"
},
{
"start": 425.478,
"end": 427.269,
"text": "detik ke depan. Tapi kamu tidak"
},
{
"start": 427.269,
"end": 429.811,
"text": "pernah melihat apa yang benar-benar penting."
},
{
"start": 430.261,
"end": 433.439,
"text": "Uang bisa dicari lagi. Orang tua tidak."
},
{
"start": 433.889,
"end": 435.541,
"text": "Dan ada satu pelajaran lain yang"
},
{
"start": 435.541,
"end": 437.4,
"text": "kamu pahami, yang berlaku juga untuk"
},
{
"start": 437.4,
"end": 439.413,
"text": "kita yang tidak punya kekuatan apa-apa."
},
{
"start": 439.863,
"end": 442.645,
"text": "Pasar saham tidak pernah memberi kepastian."
},
{
"start": 442.645,
"end": 445.298,
"text": "Bahkan dengan kemampuan melihat ke depan,"
},
{
"start": 445.298,
"end": 446.656,
"text": "kamu tetap bisa rugi."
},
{
"start": 447.106,
"end": 449.832,
"text": "Karena itu, jangan pernah memasukkan seluruh"
},
{
"start": 449.832,
"end": 452.557,
"text": "tabungan ke satu tempat. Jangan berinvestasi"
},
{
"start": 452.557,
"end": 454.972,
"text": "hanya karena melihat orang lain untung."
},
{
"start": 455.422,
"end": 457.415,
"text": "Dan jangan percaya siapa pun yang"
},
{
"start": 457.415,
"end": 459.649,
"text": "mengaku tahu pasti harga besok. Kalau"
},
{
"start": 459.649,
"end": 462.125,
"text": "ada yang menjanjikan untung tanpa risiko,"
},
{
"start": 462.125,
"end": 463.695,
"text": "hampir pasti itu penipuan."
},
{
"start": 464.145,
"end": 466.941,
"text": "Seminggu kemudian, sebuah amplop cokelat tanpa nama"
},
{
"start": 466.941,
"end": 469.19,
"text": "pengirim tergeletak di depan pintu kosmu."
},
{
"start": 469.64,
"end": 472.162,
"text": "Di dalamnya, ada selembar foto lama."
},
{
"start": 472.162,
"end": 475.244,
"text": "Sebuah layar perdagangan, penuh angka merah."
},
{
"start": 475.244,
"end": 477.977,
"text": "Di pojoknya tertulis tanggal dari tahun"
},
{
"start": 477.977,
"end": 480.639,
"text": "sembilan belas sembilan puluh delapan."
},
{
"start": 481.089,
"end": 482.478,
"text": "Di balik foto itu, ada"
},
{
"start": 482.478,
"end": 484.246,
"text": "satu kalimat tulisan tangan."
},
{
"start": 484.696,
"end": 486.589,
"text": "Surat: Kamu bukan yang pertama."
},
{
"start": 487.039,
"end": 489.634,
"text": "Kamu membalik amplop itu. Ada alamat"
},
{
"start": 489.634,
"end": 491.869,
