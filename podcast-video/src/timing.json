 ["no", 76.375, 76.6], ["Plan", 76.625, 76.963], ["B", 76.975, 77.188], ["to", 77.213, 77.3], ["fall", 77.312, 77.612], ["back", 77.625, 77.938], ["on", 77.95, 78.163], ["when", 78.263, 78.388], ["a", 78.4, 78.438], ["silicon", 78.45, 78.95], ["brain", 78.963, 79.338], ["can", 79.35, 79.475], ["do", 79.487, 79.662], ["everything", 79.775, 80.263], ["better,", 80.275, 80.675], ["faster,", 81.025, 81.613], ["and", 81.888, 81.975], ["exponentially", 81.987, 82.688], ["cheaper", 82.7, 83.038], ["than", 83.05, 83.2], ["you.", 83.213, 83.425], ["Sure,", 83.85, 84.237], ["maybe", 84.513, 84.763], ["a", 84.775, 84.825], ["billionaire", 84.838, 85.388], ["like", 85.4, 85.575], ["Warren", 85.588, 85.888], ["Buffett", 85.9, 86.263], ["will", 86.275, 86.425], ["keep", 86.438, 86.675], ["a", 86.688, 86.737], ["human", 86.75, 87.112], ["accountant", 87.125, 87.6], ["purely", 87.612, 88.212], ["as", 88.225, 88.375], ["a", 88.388, 88.425], ["nostalgic", 88.438, 89.175], ["novelty\u2014", 89.188, 89.775], ["like", 90.1, 90.275], ["buying", 90.287, 90.637], ["a", 90.65, 90.688], ["handmade", 90.7, 91.275], ["artisanal", 91.287, 91.887], ["craft", 91.9, 92.363], ["instead", 92.487, 92.9], ["of", 92.912, 92.962], ["a", 92.975, 93.025], ["mass-produced", 93.037, 93.8], ["product\u2014", 93.812, 94.263], ["but", 94.575, 94.7], ["for", 94.713, 94.825], ["99%", 94.838, 95.812], ["of", 95.825, 95.888], ["humanity,", 95.9, 96.475], ["the", 96.787, 96.875], ["job", 96.888, 97.138], ["market", 97.15, 97.525], ["will", 97.537, 97.65], ["simply", 97.662, 98.075], ["cease", 98.088, 98.4], ["to", 98.412, 98.537], ["exist.", 98.55, 99.1], ["We", 99.525, 99.713], ["are", 99.725, 99.837], ["hurtling", 99.85, 100.312], ["toward", 100.325, 100.575], ["a", 100.588, 100.625], ["future", 100.638, 101.175], ["where", 101.188, 101.375], ["our", 101.388, 101.525], ["basic", 101.537, 102.0], ["needs", 102.013, 102.413], ["might", 102.425, 102.65], ["be", 102.662, 102.787], ["met", 102.8, 103.087], ["through", 103.1, 103.325], ["infinite", 103.4, 103.925], ["digital", 103.938, 104.338], ["labor", 104.35, 104.762], ["and", 105.0, 105.062], ["extreme", 105.075, 105.625], ["wealth", 105.638, 105.862], ["abundance,", 105.875, 106.45], ["but", 106.75, 106.862], ["it", 106.875, 106.95], ["forces", 106.963, 107.388], ["a", 107.4, 107.525], ["deeply", 107.6, 108.075], ["uncomfortable,", 108.088, 108.963], ["existential", 109.375, 110.025], ["question:", 110.037, 110.525], ["What", 110.963, 111.05], ["do", 111.062, 111.112], ["you", 111.125, 111.25], ["do", 111.263, 111.475], ["with", 111.487, 111.638], ["your", 111.65, 111.788], ["life", 111.8, 112.188], ["when", 112.438, 112.537], ["you", 112.55, 112.638], ["have", 112.65, 112.9], ["80", 113.062, 113.375], ["extra", 113.388, 113.713], ["hours", 113.725, 114.037], ["a", 114.05, 114.125], ["week", 114.138, 114.5], ["and", 114.787, 114.95], ["absolutely", 115.0, 115.638], ["no", 115.65, 115.963], ["economic", 116.05, 116.525], ["purpose", 116.537, 116.912], ["in", 116.925, 117.0], ["society?", 117.013, 117.588]], "cues": [[0.1, 2.237, "We have always been comforted by the historical"], [2.25, 5.825, "promise that new technology simply creates new jobs."], [6.237, 7.338, "When we invented the wheel,"], [7.625, 8.875, "we needed cart drivers."], [9.287, 10.862, "During the Industrial Revolution,"], [11.162, 14.213, "we needed factory workers to supervise the machines."], [14.625, 16.438, "But Artificial General Intelligence\u2014"], [16.625, 20.75, "or AGI\u2014 shatters this historical safety net entirely."], [21.163, 23.05, "We are no longer just inventing a new"], [23.062, 24.488, "tool for humans to use;"], [24.913, 26.812, "we are inventing a new inventor."], [27.225, 29.1, "We are building a replacement for the human"], [29.113, 29.913, "mind itself."], [30.337, 31.9, "By the year 2027,"], [32.2, 35.562, "the capability to replace almost every single cognitive"], [35.575, 37.525, "task will be fully realized."], [37.962, 39.675, "Think about the speed of this evolution."], [40.087, 41.237, "Just three years ago,"], [41.562, 45.3, "large language models struggled to multiply three-digit numbers."], [45.712, 49.15, "Today, they are winning global mathematics olympiads and"], [49.163, 51.462, "working on millennial-level scientific proofs."], [51.888, 55.775, "By 2030, humanoid robots connected to these super-brains will"], [55.788, 57.85, "wipe out the need for physical labor."], [58.275, 60.275, "Plumbers, builders, chefs\u2014"], [60.375, 61.163, "all automated."], [61.575, 63.6, "It genuinely does not matter if you are"], [63.612, 66.838, "an Uber driver confidently navigating the chaotic streets"], [66.85, 67.462, "of New York,"], [67.737, 69.388, "a tenured university professor,"], [69.8, 71.325, "or a high-level digital creator."], [71.737, 74.487, "The idea of retraining for a new economy"], [74.675, 75.663, "is a complete myth."], [76.088, 77.938, "There is no Plan B to fall back"], [77.95, 80.263, "on when a silicon brain can do everything"], [80.275, 83.425, "better, faster, and exponentially cheaper than you."], [83.85, 86.425, "Sure, maybe a billionaire like Warren Buffett will"], [86.438, 89.175, "keep a human accountant purely as a nostalgic"], [89.188, 92.9, "novelty\u2014 like buying a handmade artisanal craft instead"], [92.912, 94.263, "of a mass-produced product\u2014"], [94.575, 96.475, "but for 99% of humanity,"], [96.787, 99.1, "the job market will simply cease to exist."], [99.525, 101.525, "We are hurtling toward a future where our"], [101.537, 104.338, "basic needs might be met through infinite digital"], [104.35, 106.45, "labor and extreme wealth abundance,"], [106.75, 108.963, "but it forces a deeply uncomfortable,"], [109.375, 110.525, "existential question:"], [110.963, 112.537, "What do you do with your life when"], [112.55, 114.95, "you have 80 extra hours a week and"], [115.0, 117.588, "absolutely no economic purpose in society?"]]}, "S03": {"frames": 528, "words": [["But", 0.113, 0.188], ["a", 0.2, 0.25], ["world", 0.263, 0.637], ["without", 0.65, 1.05], ["work", 1.062, 1.35], ["is", 1.425, 1.55], ["just", 1.562, 1.837], ["a", 1.85, 1.9], ["symptom", 1.913, 2.513], ["of", 2.612, 2.7], ["a", 2.712, 2.762], ["much", 2.775, 3.1], ["darker,", 3.112, 3.55], ["much", 3.95, 4.175], ["more", 4.188, 4.4], ["urgent", 4.463, 4.763], ["reality.", 4.775, 5.312], ["Because", 5.737, 5.962], ["the", 5.975, 6.062], ["true", 6.075, 6.375], ["danger", 6.388, 6.825], ["isn't", 6.838, 7.1], ["that", 7.112, 7.275], ["AI", 7.388, 7.788], ["will", 7.8, 7.938], ["take", 7.95, 8.2], ["our", 8.213, 8.312], ["paychecks.", 8.325, 8.962], ["It", 9.375, 9.45], ["is", 9.463, 9.562], ["that", 9.575, 9.737], ["the", 9.75, 9.85], ["people", 9.863, 10.263], ["building", 10.275, 10.688], ["this", 10.7, 10.875], ["god-like", 10.887, 11.412], ["intelligence", 11.425, 12.113], ["have", 12.225, 12.463], ["realized", 12.475, 13.05], ["a", 13.062, 13.137], ["terrifying", 13.15, 13.863], ["truth:", 13.875, 14.387], ["they", 14.713, 14.812], ["are", 14.825, 14.925], ["physically", 14.938, 15.488], ["incapable", 15.5, 16.225], ["of", 16.35, 16.438], ["controlling", 16.45, 17.037], ["it.", 17.05, 17.213]], "cues": [[0.113, 1.9, "But a world without work is just a"], [1.913, 3.55, "symptom of a much darker,"], [3.95, 5.312, "much more urgent reality."], [5.737, 7.938, "Because the true danger isn't that AI will"], [7.95, 8.962, "take our paychecks."], [9.375, 11.412, "It is that the people building this god-like"], [11.425, 14.387, "intelligence have realized a terrifying truth:"], [14.713, 17.213, "they are physically incapable of controlling it."]]}, "S04": {"frames": 3232, "words": [["Most", 0.1, 0.35], ["of", 0.362, 0.438], ["us", 0.45, 0.588], ["falsely", 0.6, 1.112], ["assume", 1.125, 1.525], ["that", 1.538, 1.7], ["tech", 1.712, 1.962], ["giants", 1.975, 2.363], ["have", 2.375, 2.513], ["a", 2.525, 2.562], ["master", 2.575, 3.05], ["switch.", 3.062, 3.55], [