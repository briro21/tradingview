5], ["then", 87.838, 88.1], ["every", 88.275, 88.525], ["second.", 88.537, 89.012], ["Trying", 89.425, 89.7], ["to", 89.713, 89.788], ["predict", 89.8, 90.225], ["what", 90.237, 90.35], ["a", 90.362, 90.412], ["superintelligence", 90.425, 91.375], ["will", 91.388, 91.513], ["do", 91.525, 91.8], ["at", 91.812, 91.912], ["that", 91.925, 92.125], ["stage", 92.138, 92.625], ["is", 92.763, 92.862], ["like", 92.875, 93.013], ["a", 93.025, 93.075], ["French", 93.088, 93.475], ["Bulldog", 93.487, 94.05], ["trying", 94.175, 94.487], ["to", 94.5, 94.575], ["understand", 94.588, 95.188], ["why", 95.2, 95.4], ["its", 95.412, 95.55], ["owner", 95.6, 95.95], ["is", 96.075, 96.163], ["hosting", 96.175, 96.525], ["a", 96.537, 96.575], ["podcast.", 96.588, 97.312], ["The", 97.737, 97.8], ["cognitive", 97.812, 98.325], ["gap", 98.338, 98.7], ["is", 98.825, 98.925], ["simply", 98.938, 99.25], ["too", 99.263, 99.5], ["massive.", 99.513, 100.025], ["We", 100.45, 100.625], ["are", 100.638, 100.75], ["creating", 100.763, 101.275], ["a", 101.287, 101.4], ["digital", 101.475, 101.887], ["god,", 101.9, 102.35], ["and", 102.725, 102.8], ["we", 102.812, 102.938], ["have", 102.95, 103.138], ["absolutely", 103.263, 103.963], ["no", 103.975, 104.262], ["proven", 104.275, 104.713], ["mathematical", 104.725, 105.412], ["way", 105.425, 105.65], ["to", 105.662, 105.825], ["ensure", 105.838, 106.25], ["it", 106.312, 106.412], ["keeps", 106.425, 106.725], ["us", 106.737, 106.862], ["alive.", 106.875, 107.338]], "cues": [[0.1, 2.363, "Most of us falsely assume that tech giants"], [2.375, 3.55, "have a master switch."], [3.962, 5.15, "If an AI goes rogue,"], [5.45, 6.325, "you just pull the plug,"], [6.375, 6.638, "right?"], [7.05, 7.388, "Wrong."], [7.812, 10.15, "Telling a developer to just pull the plug"], [10.45, 13.738, "on a decentralized superintelligence is like telling someone"], [13.875, 15.725, "to just turn off a computer virus,"], [16.1, 18.3, "or shut down the entire Bitcoin network."], [18.712, 20.062, "It is physically impossible."], [20.488, 21.837, "These systems are distributed,"], [22.087, 23.725, "backed up, and ultimately,"], [24.025, 25.938, "they will be vastly smarter than us."], [26.363, 27.925, "They will predict your attempt to turn them"], [27.938, 28.3, "off,"], [28.762, 30.188, "and they will disable you first."], [30.6, 33.8, "Right now, AI development is not traditional software"], [33.812, 36.388, "engineering; it is more like growing an alien"], [36.4, 37.062, "biology."], [37.475, 40.512, "Developers aren't writing line-by-line instructions anymore."], [40.938, 43.238, "They are feeding massive amounts of data into"], [43.25, 44.2, "a supercomputer,"], [44.6, 45.662, "waiting for it to grow,"], [45.987, 48.0, "and then experimenting on it just to figure"], [48.013, 49.237, "out what it can actually do."], [49.663, 51.688, "They are running blind experiments on a black"], [51.7, 52.238, "box."], [52.65, 53.863, "To stop bad behavior,"], [54.125, 56.05, "companies try to patch over the issues\u2014"], [56.337, 58.65, "like handing a rogue employee an HR manual"], [59.025, 60.812, "and simply asking them not to swear."], [61.237, 63.863, "But a superintelligent system will always find a"], [63.875, 64.575, "workaround."], [65.0, 68.412, "While AI capabilities are exploding at a hyper-exponential"], [68.425, 72.388, "rate, progress in AI safety is essentially flatlining."], [72.812, 75.037, "The gap between the machine's power and our"], [75.05, 77.912, "ability to control it is widening every single"], [77.925, 78.35, "second."], [78.775, 81.125, "We are rapidly approaching the Singularity\u2014"], [81.438, 83.562, "an absolute point of no return where the"], [83.575, 86.088, "machine improves its own code every hour,"], [86.475, 87.45, "then every minute,"], [87.838, 89.012, "then every second."], [89.425, 91.8, "Trying to predict what a superintelligence will do"], [91.812, 94.05, "at that stage is like a French Bulldog"], [94.175, 96.525, "trying to understand why its owner is hosting"], [96.537, 97.312, "a podcast."], [97.737, 100.025, "The cognitive gap is simply too massive."], [100.45, 102.35, "We are creating a digital god,"], [102.725, 105.65, "and we have absolutely no proven mathematical way"], [105.662, 107.338, "to ensure it keeps us alive."]]}, "S05": {"frames": 569, "words": [["So,", 0.113, 0.462], ["if", 0.7, 0.85], ["we", 0.863, 1.0], ["are", 1.012, 1.125], ["barreling", 1.137, 1.612], ["toward", 1.625, 1.9], ["an", 1.913, 2.038], ["uncontrollable", 2.05, 2.95], ["future", 2.962, 3.438], ["governed", 3.45, 3.85], ["by", 3.862, 4.0], ["machines", 4.013, 4.5], ["that", 4.513, 4.675], ["view", 4.688, 4.987], ["us", 5.0, 5.175], ["the", 5.188, 5.275], ["way", 5.287, 5.525], ["we", 5.537, 5.712], ["view", 5.725, 6.012], ["household", 6.025, 6.538], ["pets,", 6.55, 7.0], ["how", 7.425, 7.513], ["do", 7.525, 7.613], ["we", 7.625, 7.737], ["make", 7.75, 7.963], ["sense", 7.975, 8.338], ["of", 8.35, 8.425], ["our", 8.438, 8.562], ["existence", 8.575, 9.112], ["today?", 9.125, 9.475], ["What", 9.9, 10.037], ["Dr.", 10.05, 10.4], ["Yampolskiy", 10.412, 11.037], ["revealed", 11.05, 11.6], ["next", 11.613, 11.975], ["completely", 11.988, 12.588], ["shatters", 12.6, 13.075], ["how", 13.088, 13.263], ["we", 13.275, 13.425], ["think", 13.438, 13.713], ["about", 13.725, 14.012], ["our", 14.025, 14.15], ["reality,", 14.162, 14.762], ["our", 15.125, 15.262], ["religions,", 15.275, 15.925], ["and", 16.188, 16.288], ["the", 16.3, 16.387], ["very", 16.4, 16.762], ["fabric", 16.775, 17.362], ["of", 17.375, 17.475], ["the", 17.488, 17.538], ["universe", 17.55, 18.05], ["itself.", 18.062, 18.587]], "cues": [[0.113, 2.95, "So, if we are barreling toward an uncontrollable"], [2.962, 5.275, "future governed by machines that view us the"], [5.287, 7.0, "way we view household pets,"], [7.425, 9.112, "how do we make sense of our existence"], [9.125, 9.475, "today?"], [9.9, 13.263, "What Dr. Yampolskiy revealed next completely shatters how"], [13.275, 14.762, "we think about our reality,"], [15.125, 17.538, "our religions, and the very fabric of the"], [17.55, 18.587, "universe itself."]]}, "S06": {"frames": 2872, "words": [["Think", 0.113, 0.237], ["about", 0.25, 0.475], ["the", 0.487, 0.55], ["video", 0.562, 0.912], ["games", 0.925, 1.212], ["kids", 1.225, 1.463], ["play", 1.475, 1.675], ["today.", 1.688, 2.038], ["We", 2.45, 2.55], ["can", 2.562, 2.7], ["already", 2.712, 3.125], ["generate", 3.138, 3.675], ["massive,", 3.688, 4.3], ["persistent", 4.475, 5.1], ["three-dimensional", 5.112, 5.875], ["worlds", 5.888, 6.312], ["from", 6.463, 6.613], ["a", 6.625, 6.662], ["single", 6.675, 7.062], ["text", 7.075, 7.375], ["prompt.", 7.388, 7.825], ["Now,", 8.238, 8.488], ["fast", 8.85, 9.175], ["forward", 9.188, 9.45], ["a", 9.463, 9.5], ["few", 9.512, 9.725], ["decades.", 9.738, 10.338], ["Imagine", 10.75, 11.238], ["a", 11.25, 11.312], ["superintelligent", 11.325, 12.275], ["system", 12.287, 12.725], ["capable", 12.738, 13.275], ["of", 13.287, 13.412], ["perfectly", 13.425, 14.05], ["simulating", 14.062, 14.7], ["reality", 14.713, 15.213], ["down", 15.225, 15.612], ["to", 15.625, 15.738], ["the", 15.75, 15.85], ["subatomic", 15.863, 16.525], ["level,", 16.538, 16.863], ["with", 17.163, 17.312], ["perfect", 17.325, 17.738], ["physics,", 17.75, 18.363], ["perfect", 18.6, 18.963], ["haptics,", 18.975, 19.6], ["and", 19.8, 19.95], ["perfect", 19.962, 20.425], ["memory.", 20.438, 20.863], ["The", 21.275, 21.337], ["exact", 21.35, 21.85], ["moment", 21.863, 22.275], ["this", 22.288, 22.475], ["technology", 22.488, 23.15], ["becomes", 23.163, 23.588], ["affordable\u2014", 23.6, 24.113], ["let's", 24.55, 24.688], ["say", 24.7, 24.875], ["it", 24.887, 24.975], ["costs", 24.988, 25.413], ["ten", 25.425, 25.663], ["dollars", 25.675, 26.075], ["to", 26.087, 26.212], ["run", 26.225, 26.513], ["a", 26.525, 26.587], ["planetary", 26.6, 27.225], ["simulation\u2014", 27.238, 27.925], ["f