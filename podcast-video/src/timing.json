 85.5], ["time", 85.513, 85.8], ["in", 85.812, 85.888], ["human", 85.9, 86.163], ["history,", 86.175, 86.65], ["the", 86.912, 87.037], ["absolute", 87.112, 87.7], ["cutting", 87.713, 88.088], ["edge", 88.1, 88.35], ["of", 88.362, 88.45], ["computer", 88.463, 88.925], ["science", 88.938, 89.463], ["and", 89.562, 89.688], ["the", 89.7, 89.788], ["ancient", 89.888, 90.275], ["texts", 90.287, 90.7], ["of", 90.713, 90.8], ["early", 90.812, 91.1], ["religion", 91.112, 91.612], ["are", 91.725, 91.85], ["perfectly", 91.862, 92.438], ["aligned.", 92.45, 92.925], ["They", 93.35, 93.438], ["are", 93.45, 93.513], ["describing", 93.525, 94.1], ["the", 94.112, 94.188], ["exact", 94.2, 94.675], ["same", 94.688, 94.95], ["code.", 94.963, 95.338]], "cues": [[0.113, 2.038, "Think about the video games kids play today."], [2.45, 4.3, "We can already generate massive,"], [4.475, 7.825, "persistent three-dimensional worlds from a single text prompt."], [8.238, 8.488, "Now,"], [8.85, 10.338, "fast forward a few decades."], [10.75, 14.7, "Imagine a superintelligent system capable of perfectly simulating"], [14.713, 16.863, "reality down to the subatomic level,"], [17.163, 18.363, "with perfect physics,"], [18.6, 20.863, "perfect haptics, and perfect memory."], [21.275, 24.113, "The exact moment this technology becomes affordable\u2014"], [24.55, 26.513, "let's say it costs ten dollars to run"], [26.525, 27.925, "a planetary simulation\u2014"], [28.25, 31.9, "future civilizations or advanced AIs will run billions"], [31.913, 34.55, "of hyper-realistic simulations of human history."], [34.975, 36.45, "They will run them for research,"], [36.625, 37.387, "for entertainment,"], [37.775, 39.638, "or just as an algorithmic experiment."], [40.062, 43.237, "Statistically speaking, if there are billions of simulated"], [43.25, 45.925, "universes and only one base reality,"], [46.237, 48.25, "the mathematical odds that you and I are"], [48.263, 49.712, "currently living in the one,"], [50.038, 52.35, "true base reality are roughly one in a"], [52.362, 52.75, "billion."], [53.175, 55.7, "We are almost certainly living inside a computer"], [55.712, 56.837, "simulation right now."], [57.25, 58.325, "And if you look closely,"], [58.688, 61.062, "human history has subtly known this all along."], [61.475, 63.55, "If you strip away the local traditions,"], [63.725, 65.6, "the specific dietary rules,"], [65.8, 68.4, "and the regional politics from every major religion"], [68.412, 70.662, "on Earth, they all point to the exact"], [70.675, 73.163, "same fundamental, unshakeable truth:"], [73.662, 76.45, "A superintelligent creator built a secondary world,"], [76.75, 79.138, "placed us inside it for testing purposes,"], [79.438, 80.65, "monitors our behavior,"], [80.938, 83.287, "and designed a system of rules and consequences"], [83.3, 84.225, "for us to follow."], [84.662, 86.65, "For the very first time in human history,"], [86.912, 89.688, "the absolute cutting edge of computer science and"], [89.7, 92.438, "the ancient texts of early religion are perfectly"], [92.45, 92.925, "aligned."], [93.35, 95.338, "They are describing the exact same code."]]}, "S07": {"frames": 790, "words": [["Ultimately,", 0.1, 0.688], ["humanity", 0.975, 1.637], ["is", 1.65, 1.775], ["blindly", 1.788, 2.388], ["pouring", 2.4, 2.9], ["billions", 2.913, 3.425], ["of", 3.438, 3.538], ["dollars", 3.55, 3.962], ["into", 3.975, 4.312], ["an", 4.325, 4.463], ["alien", 4.513, 4.9], ["intelligence", 4.912, 5.612], ["that", 5.625, 5.775], ["will", 5.787, 5.925], ["either", 6.075, 6.362], ["liberate", 6.375, 6.825], ["us", 6.838, 7.038], ["entirely", 7.05, 7.787], ["from", 7.8, 7.95], ["the", 7.963, 8.062], ["burden", 8.137, 8.587], ["of", 8.6, 8.688], ["physical", 8.7, 9.212], ["labor,", 9.225, 9.612], ["or", 10.012, 10.137], ["erase", 10.15, 10.588], ["our", 10.6, 10.787], ["reality", 10.8, 11.312], ["from", 11.325, 11.487], ["the", 11.5, 11.562], ["map\u2014", 11.575, 11.925], ["and", 12.262, 12.3