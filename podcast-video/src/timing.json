minute", 34.725, 35.388], ["animated", 35.45, 35.875], ["summary.", 35.888, 36.388], ["Watch", 36.812, 37.025], ["the", 37.038, 37.138], ["full", 37.15, 37.413], ["breakdown", 37.425, 37.9], ["on", 37.913, 38.0], ["my", 38.013, 38.138], ["channel,", 38.15, 38.562], ["and", 38.862, 38.912], ["subscribe", 38.925, 39.438], ["so", 39.45, 39.575], ["you", 39.587, 39.7], ["don't", 39.712, 39.95], ["miss", 39.962, 40.137], ["what", 40.15, 40.262], ["comes", 40.275, 40.5], ["next.", 40.513, 40.988]], "cues": [[0.113, 2.963, "Steven Bartlett sat down with AI safety expert"], [3.038, 4.4, "Dr. Roman Yampolskiy,"], [4.713, 6.788, "and what he said is genuinely terrifying."], [7.213, 8.2, "By 2027,"], [8.637, 11.613, "AI could replace almost every cognitive task."], [12.037, 15.388, "By 2030, humanoid robots take physical labor too."], [15.812, 17.712, "Plumbers, builders, chefs."], [18.125, 18.6, "Retraining?"], [19.025, 19.812, "He calls it a myth."], [20.225, 21.037, "And it gets worse."], [21.462, 22.925, "You cannot just pull the plug on a"], [22.938, 23.975, "superintelligence."], [24.387, 25.5, "It will predict your move,"], [25.8, 26.913, "and disable you first."], [27.337, 28.438, "Then he goes even further:"], [28.962, 31.938, "we are almost certainly living inside a simulation."], [32.35, 35.388, "I turned this entire conversation into a seven-minute"], [35.45, 36.388, "animated summary."], [36.812, 38.562, "Watch the full breakdown on my channel,"], [38.862, 40.5, "and subscribe so you don't miss what comes"], [40.513, 40.988, "next."]]}}