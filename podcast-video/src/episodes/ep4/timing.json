53.525], ["in", 53.538, 53.6], ["the", 53.612, 53.688], ["ballroom,", 53.7, 54.2], ["had", 54.562, 54.663], ["happened", 54.675, 55.137], ["just", 55.212, 55.538], ["inches", 55.55, 55.887], ["from", 55.9, 56.062], ["hidden", 56.075, 56.35], ["corridors", 56.362, 57.037], ["and", 57.225, 57.375], ["whispered", 57.388, 57.85], ["ruin.", 57.862, 58.2], ["The", 58.612, 58.662], ["next", 58.675, 58.95], ["day,", 58.962, 59.288], ["the", 59.55, 59.65], ["crew", 59.663, 59.938], ["laid", 59.95, 60.175], ["new", 60.188, 60.525], ["oak", 60.538, 60.788], ["boards", 60.8, 61.162], ["over", 61.175, 61.375], ["the", 61.388, 61.463], ["cavity", 61.475, 62.013], ["and", 62.138, 62.275], ["nailed", 62.288, 62.6], ["them", 62.612, 62.75], ["tight.", 62.763, 63.175], ["But", 63.6, 63.675], ["the", 63.688, 63.763], ["secret", 63.775, 64.138], ["was", 64.15, 64.3], ["out.", 64.312, 64.588]], "cues": [[0.113, 1.938, "Which brings us back to the copper box."], [2.35, 5.025, "Beneath the letters lay a hand-drawn schematic of"], [5.037, 5.938, "the first floor."], [6.35, 7.25, "At first glance,"], [7.463, 9.362, "it matched the modern survey perfectly."], [9.787, 10.513, "The grand hall,"], [10.787, 12.537, "the conservatory, the library."], [12.963, 13.95, "But held up to the light,"], [14.25, 15.838, "faint dotted lines appeared."], [16.25, 17.975, "The architect had built a second,"], [18.363, 20.575, "hidden structure into the bones of the house."], [20.988, 23.325, "The library paneling the crew had spent weeks"], [23.337, 25.175, "cleaning was designed to be hollow."], [25.6, 26.95, "Behind it, a narrow,"], [27.137, 30.075, "windowless corridor ran parallel to the main hallway,"], [30.475, 32.75, "down to a sub-basement that exists on no"], [32.763, 33.65, "city registry."], [34.062, 34.763, "A phantom wing."], [35.188, 36.538, "Built, the letters hint,"], [36.837, 38.487, "for moving illicit goods,"], [38.763, 40.737, "or as an escape route for a family"], [40.75, 43.238, "whose fortune stood on a crumbling foundation."], [43.65, 46.288, "Suddenly, the quirks of the house made sense."], [46.712, 48.875, "The strange thickness of the western wall."], [49.3, 51.338, "The echo under the butler's pantry floor."], [51.75, 52.638, "Every dinner party,"], [52.938, 54.2, "every waltz in the ballroom,"], [54.562, 57.375, "had happened just inches from hidden corridors and"], [57.388, 58.2, "whispered ruin."], [58.612, 59.288, "The next day,"], [59.55, 61.463, "the crew laid new oak boards over the"], [61.475, 63.175, "cavity and nailed them tight."], [63.6, 64.588, "But the secret was out."]]}, "S07": {"frames": 1580, "words": [["Outside,", 0.1, 0.713], ["the", 1.075, 1.15], ["wilderness", 1.163, 1.713], ["that", 1.725, 1.938], ["nearly", 1.95, 2.375], ["swallowed", 2.388, 2.888], ["the", 2.9, 2.962], ["mansion", 2.975, 3.475], ["is", 3.55, 3.675], ["tamed", 3.688, 4.112], ["into", 4.188, 4.45], ["a", 4.463, 4.513], ["manicured", 4.525, 5.138], ["estate.", 5.15, 5.638], ["A", 6.037, 6.1], ["gravel", 6.112, 6.487], ["driveway", 6.5, 7.05], ["curves", 7.062, 7.487], ["toward", 7.5, 7.75], ["the", 7.763, 7.838], ["grand", 7.85, 8.225], ["entrance", 8.35, 8.787], ["between", 8.8, 9.15], ["freshly", 9.162, 9.688], ["planted", 9.7, 10.075], ["hedges.", 10.088, 10.6], ["The", 11.025, 11.075], ["fountains,", 11.088, 11.75], ["dry", 11.863, 12.238], ["and", 12.25, 12.375], ["cracked", 12.387, 12.775], ["for", 12.787, 12.925], ["decades,", 12.938, 13.562], ["surge", 13.9, 14.325], ["back", 14.338, 14.613], ["to", 14.625, 14.738], ["life,", 14.75, 15.175], ["and", 15.575, 15.637], ["their", 15.65, 15.812], ["sound", 15.825, 16.225], ["breaks", 16.238, 16.55], ["the", 16.562, 16.663], ["silence", 16.675, 17.2], ["of", 17.212, 17.287], ["the", 17.3, 17.363], ["grounds.", 17.375, 17.988], ["As", 18.4, 18.562], ["evening", 18.575, 18.887], ["falls,", 18.9, 19.4], ["the", 19.587, 19.7], ["last", 19.712, 20.162], ["and", 20.275, 20.4], ["most", 20.413, 20.7], ["impor