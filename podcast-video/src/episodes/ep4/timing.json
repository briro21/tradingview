", 0.3, 0.387], ["a", 0.4, 0.45], ["quiet", 0.463, 0.85], ["thief.", 0.863, 1.312], ["It", 1.725, 1.812], ["doesn't", 1.825, 2.087], ["steal", 2.1, 2.45], ["a", 2.462, 2.512], ["legacy", 2.525, 3.037], ["all", 3.05, 3.3], ["at", 3.312, 3.413], ["once.", 3.425, 3.887], ["It", 4.3, 4.388], ["erodes", 4.4, 4.8], ["it,", 4.812, 4.95], ["season", 5.188, 5.487], ["by", 5.5, 5.638], ["season.", 5.65, 6.062], ["First", 6.55, 6.787], ["the", 6.8, 6.9], ["laughter", 6.912, 7.387], ["from", 7.4, 7.562], ["the", 7.575, 7.65], ["grand", 7.662, 7.962], ["halls,", 7.975, 8.438], ["then", 8.713, 8.85], ["the", 8.863, 8.975], ["warmth", 8.988, 9.363], ["from", 9.375, 9.537], ["the", 9.55, 9.613], ["hearth,", 9.625, 10.025], ["and", 10.325, 10.425], ["finally", 10.438, 10.887], ["the", 10.9, 11.0], ["roof", 11.012, 11.387], ["that", 11.4, 11.525], ["was", 11.537, 11.713], ["built", 11.725, 12.025], ["to", 12.037, 12.137], ["protect", 12.15, 12.65], ["those", 12.662, 12.887], ["memories.", 12.9, 13.513], ["Look", 13.912, 14.025], ["at", 14.037, 14.112], ["this", 14.125, 14.275], ["place.", 14.287, 14.737], ["It", 15.15, 15.213], ["is", 15.225, 15.325], ["not", 15.338, 15.6], ["just", 15.613, 15.863], ["an", 15.875, 15.95], ["abandoned", 15.963, 16.425], ["mansion.", 16.438, 16.875], ["It", 17.288, 17.375], ["is", 17.387, 17.488], ["a", 17.5, 17.538], ["monument", 17.55, 18.163], ["to", 18.25, 18.4], ["impermanence.", 18.413, 19.175], ["Ivy", 19.587, 19.875], ["has", 19.887, 20.012], ["crawled", 20.025, 20.4], ["up", 20.413, 20.575], ["the", 20.587, 20.662], ["stone", 20.675, 21.025], ["facade,", 21.038, 21.562], ["claiming", 21.837, 22.162], ["it", 22.175, 22.275], ["back", 22.288, 22.562], ["for", 22.575, 22.688], ["the", 22.7, 22.8], ["earth.", 22.812, 23.212], ["Nature", 23.625, 23.913], ["is", 23.925, 24.012], ["patient.", 24.025, 24.55], ["It", 24.962, 25.112], ["waits", 25.125, 25.387], ["for", 25.4, 25.562], ["us", 25.575, 25.738], ["to", 25.75, 25.825], ["leave,", 25.837, 26.25], ["and", 26.625, 26.688], ["then", 26.7, 26.825], ["it", 26.837, 26.938], ["quietly", 26.95, 27.475], ["erases", 27.488, 27.975], ["our", 27.988, 28.088], ["footsteps.", 28.1, 28.825], ["The", 29.25, 29.3], ["glass", 29.312, 29.675], ["of", 29.688, 29.762], ["the", 29.775, 29.85], ["grand", 29.863, 30.238], ["conservatory", 30.25, 31.137], ["lies", 31.15, 31.45], ["shattered", 31.462, 31.938], ["in", 31.95, 32.038], ["the", 32.05, 32.175], ["dust", 32.188, 32.612], ["like", 32.625, 32.788], ["crushed", 32.8, 33.212], ["diamonds.", 33.225, 33.837], ["Floorboards", 34.3, 34.837], ["once", 34.85, 35.113], ["polished", 35.125, 35.575], ["to", 35.587, 35.7], ["a", 35.712, 35.775], ["mirror", 35.788, 36.15], ["finish", 36.163, 36.55], ["are", 36.562, 36.725], ["buckled", 36.8, 37.188], ["and", 37.45, 37.625], ["warped", 37.638, 37.988], ["by", 38.0, 38.138], ["decades", 38.15, 38.7], ["of", 38.712, 38.812], ["rain.", 38.825, 39.163], ["The", 39.587, 39.65], ["grand", 39.663, 39.988], ["staircase", 40.0, 40.663], ["curves", 40.775, 41.237], ["upward", 41.312, 41.663], ["into", 41.675, 41.85], ["nothing", 41.862, 42.312], ["but", 42.413, 42.55], ["collapsed", 42.562, 43.075], ["ceilings", 43.087, 43.725], ["and", 43.862, 44.025], ["empty", 44.163, 44.413], ["doorways.", 44.425, 45.1], ["And", 45.513, 45.638], ["yet,", 45.65, 45.987], ["beneath", 46.275, 46.688], ["the", 46.7, 46.812], ["wind", 46.825, 47.163], ["howling", 47.175, 47.7], ["through", 47.712, 47.862], ["the", 47.875, 47.975], ["broken", 47.987, 48.387], ["rafters,", 48.4, 49.075], ["the", 49.312, 49.438], ["bones", 49.45, 49.9], ["of", 49.913, 50.0], ["this", 50.013, 50.175], ["house", 50.188, 50.663], ["are", 50.8, 50.912], ["still", 50.925, 51.237], ["strong.", 51.25, 51.763], ["It", 52.175, 52.237], ["is", 52.25, 52.35], ["not", 52.362, 52.6], ["waiting", 52.612, 52.912], ["for", 52.925, 53.087], ["a", 53.1, 53.138], ["miracle.", 53.15, 53.65], ["It", 54.062, 54.138], ["is", 54.15, 54.262], ["waiting", 54.275, 54.625], ["for", 54.638, 54.788], ["an", 54.8, 54.875], ["intervention.", 54.888, 55.5], ["So", 55.913, 56.038], ["let's", 56.05, 56.237], ["rewind", 56.25, 56.587], ["the", 56.6, 56.663], ["clock.", 56.675, 57.1]], "cues": [[0.113, 1.312, "Time is a quiet thief."], [1.725, 3.887, "It doesn't steal a legacy all at once."], [4.3, 4.95, "It erodes it,"], [5.188, 6.062, "season by season."], [6.55, 8.438, "First the laughter from the grand halls,"], [8.713, 10.025, "then the warmth from the hearth,"], [10.325, 12.137, "and finally the roof that was built to"], [12.15, 13.513, "protect those memories."], [13.912, 14.737, "Look at this place."], [15.15, 16.875, "It is not just an abandoned mansion."], [17.288, 19.175, "It is a monument to impermanence."], [19.587, 21.562, "Ivy has crawled up the stone facade,"], [21.837, 23.212, "claiming it back for the earth."], [23.625, 24.55, "Nature is patient."], [24.962, 26.25, "It waits for us to leave,"], [26.625, 28.825, "and then it quietly erases our footsteps."], [29.25, 31.938, "The glass of the grand conservatory lies shattered"], [31.95, 33.837, "in the dust like crushed diamonds."], [34.3, 36.725, "Floorboards once polished to a mirror finish are"], [36.8, 39.163, "buckled and warped by decades of rain."], [39.587, 42.55, "The grand staircase curves upward into nothing but"], [42.562, 45.1, "collapsed ceilings and empty doorways."], [45.513, 47.975, "And yet, beneath the wind howling through the"], [47.987, 50.912, "broken rafters, the bones of this house are"], [50.925, 51.763, "still strong."], [52.175, 53.65, "It is not waiting for a miracle."], [54.062, 55.5, "It is waiting for an intervention."], [55.913, 57.1, "So let's rewind the clock."]]}, "S02": {"frames": 1326, "words": [["Before", 0.113, 0.475], ["a", 0.487, 0.525], ["resurrection,", 0.537, 1.262], ["there", 1.625, 1.725], ["must", 1.738, 1.95], ["be", 1.962, 2.075], ["a", 2.087, 2.15], ["reckoning.", 2.163, 2.638], ["The", 3.062, 3.125], ["first", 3.1