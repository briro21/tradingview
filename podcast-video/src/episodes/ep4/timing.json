 32.025], ["to", 32.038, 32.125], ["the", 32.138, 32.238], ["towering", 32.25, 32.688], ["ceilings.", 32.7, 33.375], ["Crystal", 33.788, 34.163], ["chandeliers", 34.175, 34.912], ["scatter", 34.925, 35.375], ["the", 35.388, 35.488], ["light", 35.5, 35.875], ["into", 36.075, 36.325], ["a", 36.337, 36.387], ["thousand", 36.4, 37.025], ["tiny", 37.038, 37.4], ["prisms.", 37.413, 38.05], ["This", 38.475, 38.613], ["is", 38.625, 38.725], ["the", 38.737, 38.837], ["phase", 38.85, 39.363], ["of", 39.375, 39.438], ["obsession.", 39.45, 40.025], ["Carved", 40.438, 40.675], ["rosettes", 40.688, 41.163], ["above", 41.175, 41.475], ["the", 41.487, 41.562], ["doorways.", 41.575, 42.213], ["Heavy", 42.625, 42.85], ["brass", 42.862, 43.212], ["hinges", 43.225, 43.55], ["on", 43.562, 43.7], ["oak", 43.712, 43.938], ["doors.", 43.95, 44.463], ["The", 44.888, 44.963], ["details", 44.975, 45.45], ["that", 45.462, 45.6], ["turn", 45.612, 45.887], ["construction", 45.9, 46.587], ["into", 46.688, 47.013], ["art.", 47.025, 47.387]], "cues": [[0.1, 2.288, "A structure becomes a home when it learns"], [2.3, 3.2, "to play with light."], [3.65, 6.1, "For years, the windows were black voids,"], [6.475, 8.688, "empty eyes staring into the wilderness."], [9.1, 11.525, "Now pristine glass is fitted back into the"], [11.537, 14.138, "ornate frames, and when the morning sun hits"], [14.15, 16.0, "them, the whole mansion changes."], [16.413, 19.0, "Sunbeams cut across new parquet floors,"], [19.288, 21.363, "laid in perfect geometric patterns."], [21.788, 24.1, "The colors of a forgotten era bleed back"], [24.113, 24.325, "in."], [24.75, 27.25, "Deep emerald returns to the library walls."], [27.675, 30.625, "Chipped crown moldings are restored to brilliant white,"], [31.05, 33.375, "pulling your eye up to the towering ceilings."], [33.788, 37.025, "Crystal chandeliers scatter the light into a thousand"], [37.038, 38.05, "tiny prisms."], [38.475, 40.025, "This is the phase of obsession."], [40.438, 42.213, "Carved rosettes above the doorways."], [42.625, 44.463, "Heavy brass hinges on oak doors."], [44.888, 47.387, "The details that turn construction into art."]]}, "S06": {"frames": 1950, "words": [["Which", 0.113, 0.25], ["brings", 0.263, 0.525], ["us", 0.537, 0.65], ["back", 0.662, 0.912], ["to", 0.925, 0.988], ["the", 1.0, 1.087], ["copper", 1.1, 1.4], ["box.", 1.413, 1.938], ["Beneath", 2.35, 2.625], ["the", 2.638, 2.75], ["letters", 2.763, 3.125], ["lay", 3.138, 3.4], ["a", 3.413, 3.488], ["hand-drawn", 3.5, 4.188], ["schematic", 4.2, 4.838], ["of", 4.925, 5.025], ["the", 5.037, 5.1], ["first", 5.112, 5.475], ["floor.", 5.487, 5.938], ["At", 6.35, 6.462], ["first", 6.475, 6.75], ["glance,", 6.763, 7.25], ["it", 7.463, 7.55], ["matched", 7.562, 7.888], ["the", 7.9, 7.975], ["modern", 7.987, 8.35], ["survey", 8.363, 8.75], ["perfectly.", 8.762, 9.362], ["The", 9.787, 9.838], ["grand", 9.85, 10.162], ["hall,", 10.175, 10.513], ["the", 10.787, 10.875], ["conservatory,", 10.887, 11.637], ["the", 11.838, 11.925], ["library.", 11.938, 12.537], ["But", 12.963, 13.025], ["held", 13.037, 13.25], ["up", 13.262, 13.362], ["to", 13.375, 13.463], ["the", 13.475, 13.588], ["light,", 13.6, 13.95], ["faint", 14.25, 14.637], ["dotted", 14.713, 15.037], ["lines", 15.05, 15.338], ["appeared.", 15.35, 15.838], ["The", 16.25, 16.363], ["architect", 16.375, 16.95], ["had", 16.962, 17.125], ["built", 17.137, 17.375], ["a", 17.387, 17.425], ["second,", 17.438, 17.975], ["hidden", 18.363, 18.575], ["structure", 18.587, 19.15], ["into", 19.163, 19.375], ["the", 19.387, 19.5], ["bones", 19.512, 19.863], ["of", 19.875, 19.938], ["the", 19.95, 20.012], ["house.", 20.025, 20.575], ["The", 20.988, 21.062], ["library", 21.075, 21.575], ["paneling", 21.587, 22.05], ["the", 22.062, 22.137], ["crew", 22.15, 22.525], ["had", 22.538, 22.713], ["spent", 22.725, 23.05], ["weeks", 23.062, 23.325], ["cleaning", 23.337, 23.8], ["was", 23.925, 24.062], ["designed", 24.075, 24.525], ["to", 24.538, 24