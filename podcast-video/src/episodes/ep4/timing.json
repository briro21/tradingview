12], ["that", 51.925, 52.1], ["thought.", 52.112, 52.475], ["We'll", 52.888, 52.963], ["come", 52.975, 53.1], ["back", 53.112, 53.337], ["to", 53.35, 53.5], ["it.", 53.513, 53.675]], "cues": [[0.1, 1.787, "And then, in the third week,"], [2.013, 3.838, "the house gave up its first secret."], [4.25, 5.163, "In the master study,"], [5.45, 7.625, "the crew was pulling up warped oak planks"], [7.638, 9.762, "when the crowbar struck something that wasn't wood"], [9.887, 10.463, "or stone."], [10.875, 11.637, "It was the dull,"], [11.9, 12.963, "hollow thud of metal."], [13.387, 15.8, "Wedged between two load-bearing joists,"], [16.062, 17.75, "buried in a century of dust,"], [18.137, 19.837, "sat a heavy copper lockbox,"], [20.1, 21.25, "hidden there on purpose."], [21.663, 23.163, "Inside, there was no gold."], [23.575, 24.287, "No jewels."], [24.7, 26.625, "Just a stack of brittle letters wrapped in"], [26.637, 29.05, "oilcloth, the ink faded to sepia."], [29.475, 31.462, "They were written by the original architect,"], [31.688, 35.25, "three months before the mansion's grand opening in 1912."], [35.663, 37.262, "And they were not letters of triumph."], [37.688, 39.087, "They were letters of desperation."], [39.5, 41.787, "The architect was writing to a silent partner"], [41.888, 43.85, "about a catastrophic shortage of money."], [44.263, 45.812, "To finish the grand facade,"], [46.175, 47.775, "corners had to be cut where no one"], [47.788, 48.337, "could see them."], [48.763, 51.363, "But beneath the letters was something even stranger."], [51.8, 52.475, "Hold that thought."], [52.888, 53.675, "We'll come back to it."]]}, "S04": {"frames": 1374, "words": [["Now", 0.1, 0.2], ["the", 0.212, 0.3], ["pendulum", 0.312, 0.75], ["swings", 0.762, 1.112], ["back.", 1.125, 1.538], ["The", 1.962, 2.012], ["destruction", 2.025, 2.575], ["stops,", 2.587, 3.15], ["and", 3.337, 3.438], ["creation", 3.45, 4.025], ["begins.", 4.037, 4.675], ["Stone", 5.1, 5.475], ["by", 5.487, 5.662], ["stone,", 5.675, 6.225], ["the", 6.513, 6.6], ["crumbling", 6.612, 7.087], ["corners", 7.1, 7.55], ["of", 7.562, 7.625], ["the", 7.638, 7.713], ["facade", 7.725, 8.275], ["are", 8.338, 8.513], ["realigned,", 8.525, 9.2], ["and", 9.588, 9.65], ["fresh", 9.662, 10.05], ["mortar", 10.062, 10.425], ["seals", 10.438, 10.825], ["the", 10.838, 10.938], ["wounds.", 10.95, 11.462], ["Up", 11.875, 12.012], ["top,", 12.025, 12.425], ["the", 12.65, 12.738], ["skeletal", 12.75, 13.287], ["roofline", 13.3, 13.85], ["is", 13.863, 13.988], ["crowned", 14.0, 14.35], ["again", 14.363, 14.763], ["with", 14.875, 15.012], ["solid", 15.025, 15.513], ["timber", 15.525, 15.963], ["and", 16.087, 16.175], ["heavy,", 16.188, 16.625], ["dark", 16.95, 17.188], ["slate.", 17.2, 17.613], ["For", 18.062, 18.15], ["decades,", 18.163, 18.8], ["the", 19.038, 19.138], ["silhouette", 19.15, 19.712], ["was", 19.725, 19.913], ["jagged", 19.925, 20.375], ["against", 20.387, 20.712], ["the", 20.725, 20.8], ["horizon.", 20.812, 21.375], ["Suddenly,", 21.788, 22.25], ["it", 22.288, 22.363], ["is", 22.375, 22.488], ["whole.", 22.5, 22.85], ["Inside,", 23.262, 23.85], ["the", 24.125, 24.2], ["grand", 24.212, 24.55], ["staircase,", 24.562, 25.312], ["once", 25.5, 25.738], ["a", 25.75, 25.812], ["hazard", 25.825, 26.337], ["of", 26.35, 26.463], ["rotting", 26.475, 26.838], ["wood,", 26.85, 27.138], ["is", 27.525, 27.65], ["rebuilt", 27.663, 28.238], ["in", 28.337, 28.55], ["rich,", 28.562, 28.975], ["dark", 29.212, 29.487], ["mahogany.", 29.5, 30.075], ["Fresh", 30.55, 30.8], ["plaster", 30.812, 31.288], ["glides", 31.3, 31.8], ["over", 31.812, 32.013], ["the", 32.025, 32.1], ["exposed", 32.112, 32.75], ["brick,", 32.763, 33.062], ["erasing", 33.375, 33.837], ["the", 33.85, 33.938], ["water", 33.95, 34.263], ["stains", 34.275, 34.688], ["like", 34.7, 34.838], ["a", 34.85, 34.95], ["deep", 35.025, 35.3], ["wound", 35.312, 35.712], ["healing", 35.725, 36.288], ["in", 36.438, 36.525], ["fast", 36.538, 36.938], ["forward.", 36.95, 37.388], ["Even", 37.8, 37.975], ["the", 37.987, 38.05], ["air", 38.062, 38.275], ["changes.", 38.288, 38.888], ["The", 39.312, 39.4], ["damp", 39.413, 39.688], ["smell", 39.7, 40.025], ["of", 40.038, 40.125], ["decay", 40.138, 40.55], ["gives", 40.562, 40.812], ["way", 40.825, 40.988], ["to", 41.0, 41.1], ["cut", 41.112, 41.425], ["wood,", 41.438, 41.775], ["fresh", 42.075, 42.388], ["paint,", 42.4, 42.775], ["and", 43.087, 43.2], ["raw", 43.212, 43.387], ["potential.", 43.4, 43.962], ["The", 44.375, 44.425], ["house", 44.438, 44.737], ["is", 44.75, 44.85], ["waking", 44.862, 45.188], ["up.", 45.2, 45.388]], "cues": [[0.1, 1.538, "Now the pendulum swings back."], [1.962, 3.15, "The destruction stops,"], [3.337, 4.675, "and creation begins."], [5.1, 6.225, "Stone by stone,"], [6.513, 9.2, "the crumbling corners of the facade are realigned,"], [9.588, 11.462, "and fresh mortar seals the wounds."], [11.875, 14.763, "Up top, the skeletal roofline is crowned again"], [14.875, 16.625, "with solid timber and heavy,"], [16.95, 17.613, "dark slate."], [18.062, 20.8, "For decades, the silhouette was jagged against the"], [20.812, 21.375, "horizon."], [21.788, 22.85, "Suddenly, it is whole."], [23.262, 25.312, "Inside, the grand staircase,"], [25.5, 27.138, "once a hazard of rotting wood,"], [27.525, 28.975, "is rebuilt in rich,"], [29.212, 30.075, "dark mahogany."], [30.55, 33.062, "Fresh plaster glides over the exposed brick,"], [33.375, 35.712, "erasing the water stains like a deep wound"], [35.725, 37.388, "healing in fast forward."], [37.8, 38.888, "Even the air changes."], [39.312, 41.1, "The damp smell of decay gives way to"], [41.112, 42.775, "cut wood, fresh paint,"], [43.087, 43.962, "and raw potential."], [44.375, 45.388, "The house is waking up."]]}, "S05": {"frames": 1433, "words": [["A", 0.1, 0.15], ["structure", 0.163, 0.625], ["becomes", 0.637, 1.038], ["a", 1.05, 1.088], ["home", 1.1, 1.5], ["when", 1.725, 1.825], ["it", 1.837, 1.962], ["le