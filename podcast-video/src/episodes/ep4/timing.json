, ["a", 30.9, 30.95], ["steel", 30.962, 31.312], ["cage,", 31.325, 31.837], ["holding", 32.212, 32.525], ["up", 32.538, 32.725], ["a", 32.788, 32.837], ["fragile", 32.85, 33.4], ["giant.", 33.413, 33.9], ["But", 34.325, 34.425], ["as", 34.438, 34.6], ["the", 34.612, 34.737], ["dust", 34.75, 35.112], ["settles,", 35.125, 35.7], ["the", 35.888, 36.013], ["archways", 36.025, 36.625], ["breathe", 36.638, 37.0], ["again,", 37.013, 37.463], ["and", 37.837, 37.887], ["the", 37.9, 37.987], ["flow", 38.0, 38.375], ["of", 38.388, 38.475], ["the", 38.487, 38.55], ["rooms", 38.562, 39.0], ["makes", 39.013, 39.325], ["sense", 39.337, 39.688], ["once", 39.7, 39.975], ["more.", 39.987, 40.387], ["It", 40.8, 40.862], ["is", 40.875, 40.987], ["no", 41.0, 41.163], ["longer", 41.175, 41.562], ["a", 41.575, 41.625], ["ruin.", 41.638, 42.0], ["It", 42.413, 42.488], ["is", 42.5, 42.587], ["a", 42.6, 42.65], ["canvas", 42.663, 43.075], ["wiped", 43.087, 43.387], ["clean.", 43.4, 43.812]], "cues": [[0.113, 1.262, "Before a resurrection,"], [1.625, 2.638, "there must be a reckoning."], [3.062, 5.087, "The first job is to clear away half"], [5.1, 6.3, "a century of neglect."], [6.713, 8.125, "The vines are pulled back,"], [8.412, 11.375, "revealing intricate stonework that hasn't felt the sun"], [11.387, 12.35, "in fifty years."], [12.762, 15.675, "Rotten timber and collapsed plaster are hauled out"], [15.688, 16.55, "of the great hall,"], [16.95, 17.762, "layer by layer,"], [18.163, 20.887, "until the foundation of the estate is exposed."], [21.312, 23.0, "This is the most brutal phase,"], [23.25, 25.512, "where everything looks worse before it looks better."], [25.938, 28.175, "The skeleton of the mansion stands open to"], [28.188, 28.7, "the sky."], [29.125, 31.837, "Scaffolding rises around it like a steel cage,"], [32.212, 33.9, "holding up a fragile giant."], [34.325, 35.7, "But as the dust settles,"], [35.888, 37.463, "the archways breathe again,"], [37.837, 39.688, "and the flow of the rooms makes sense"], [39.7, 40.387, "once more."], [40.8, 42.0, "It is no longer a ruin."], [42.413, 43.812, "It is a canvas wiped clean."]]}, "S03": {"frames": 1622, "words": [["And", 0.1, 0.213], ["then,", 0.225, 0.575], ["in", 0.85, 0.925], ["the", 0.938, 1.012], ["third", 1.025, 1.387], ["week,", 1.4, 1.787], ["the", 2.013, 2.1], ["house", 2.112, 2.462], ["gave", 2.475, 2.712], ["up", 2.725, 2.888], ["its", 2.9, 3.038], ["first", 3.05, 3.375], ["secret.", 3.388, 3.838], ["In", 4.25, 4.325], ["the", 4.338, 4.4], ["master", 4.412, 4.812], ["study,", 4.825, 5.163], ["the", 5.45, 5.55], ["crew", 5.562, 5.787], ["was", 5.8, 5.962], ["pulling", 5.975, 6.375], ["up", 6.388, 6.538], ["warped", 6.55, 6.888], ["oak", 6.975, 7.175], ["planks", 7.188, 7.625], ["when", 7.638, 7.737], ["the", 7.75, 7.825], ["crowbar", 7.838, 8.287], ["struck", 8.3, 8.588], ["something", 8.6, 9.0], ["that", 9.012, 9.188], ["wasn't", 9.2, 9.5], ["wood", 9.512, 9.762], ["or", 9.887, 9.987], ["stone.", 10.0, 10.463], ["It", 10.875, 10.95], ["was", 10.963, 11.1], ["the", 11.113, 11.238], ["dull,", 11.25, 11.637], ["hollow", 11.9, 12.213], ["thud", 12.225, 12.525], ["of", 12.537, 12.612], ["metal.", 12.625, 12.963], ["Wedged", 13.387, 13.662], ["between", 13.675, 14.075], ["two", 14.088, 14.375], ["load-bearing", 14.387, 15.125], ["joists,", 15.137, 15.8], ["buried", 16.062, 16.4], ["in", 16.413, 16.538], ["a", 16.55, 16.6], ["century", 16.613, 17.188], ["of", 17.2, 17.325], ["dust,", 17.337, 17.75], ["sat", 18.137, 18.325], ["a", 18.337, 18.375], ["heavy", 18.387, 18.762], ["copper", 18.775, 19.125], ["lockbox,", 19.137, 19.837], ["hidden", 20.1, 20.325], ["there", 20.337, 20.5], ["on", 20.512, 20.625], ["purpose.", 20.637, 21.25], ["Inside,", 21.663, 22.138], ["there", 22.375, 22.462], ["was", 22.475, 22.588], ["no", 22.6, 22.788], ["gold.", 22.8, 23.163], ["No", 23.575, 23.75], ["jewels.", 23.762, 24.287], ["Just", 24.7, 24.887], ["a", 24.9, 24.95], ["stack", 24.962, 25.3], ["of", 25.312, 25.