3], ["may", 48.025, 48.163], ["be", 48.175, 48.3], ["better", 48.312, 48.6], ["left", 48.612, 48.95], ["in", 48.962, 49.025], ["the", 49.038, 49.113], ["dark.", 49.125, 49.513], ["If", 49.925, 50.025], ["you", 50.038, 50.125], ["want", 50.138, 50.288], ["more", 50.3, 50.438], ["stories", 50.45, 50.85], ["like", 50.862, 51.037], ["this", 51.05, 51.237], ["one,", 51.25, 51.487], ["subscribe.", 51.7, 52.288]], "cues": [[0.1, 0.713, "Outside,"], [1.075, 3.675, "the wilderness that nearly swallowed the mansion is"], [3.688, 5.638, "tamed into a manicured estate."], [6.037, 8.787, "A gravel driveway curves toward the grand entrance"], [8.8, 10.6, "between freshly planted hedges."], [11.025, 13.562, "The fountains, dry and cracked for decades,"], [13.9, 15.175, "surge back to life,"], [15.575, 17.363, "and their sound breaks the silence of the"], [17.375, 17.988, "grounds."], [18.4, 19.4, "As evening falls,"], [19.587, 22.238, "the last and most important element arrives:"], [22.488, 23.0, "warmth."], [23.413, 26.637, "Golden light blooms behind every window and spills"], [26.65, 28.237, "across the restored terrace."], [28.65, 30.312, "It is no longer an empty shell."], [30.725, 31.375, "It is a beacon."], [31.788, 32.95, "Look back at where this started."], [33.375, 34.712, "The dust, the rot,"], [34.962, 36.2, "the crushing silence."], [36.612, 37.925, "It feels like another lifetime."], [38.337, 39.962, "No matter how deep the decay,"], [40.362, 41.837, "nothing is truly lost,"], [42.225, 43.95, "as long as someone is willing to do"], [43.962, 45.55, "the work to bring it back into the"], [45.562, 45.913, "light."], [46.325, 47.225, "Though in this house,"], [47.487, 49.113, "some things may be better left in the"], [49.125, 49.513, "dark."], [49.925, 51.487, "If you want more stories like this one,"], [51.7, 52.288, "subscribe."]]}}