471, "but a veto over the big decisions."], [33.901, 36.292, "And he sees a twist the founders may"], [36.374, 37.5, "not have thought through."], [38.173, 40.727, "If AI ever causes a scandal,"], [40.89, 43.7, "an activist government could target that one share."], [44.187, 46.335, "Take it, pay the price of an ordinary"], [46.416, 50.561, "share, and suddenly control the company's biggest decisions."], [51.049, 53.057, "The founders could fight that in court,"], [53.092, 53.8, "he says."], [54.23, 55.762, "But it paints a target."], [56.25, 58.293, "There's a practical problem too."], [58.967, 61.498, "If the business needs to change course,"], [61.857, 63.866, "who can make the founders listen?"], [64.539, 66.954, "Maybe only a falling stock price,"], [67.314, 69.462, "which he calls a blunt instrument."], [69.949, 72.492, "So what would make the business itself work?"]]}, "S04": {"frames": 2238, "words": [["Part", 0.0, 0.337], ["four.", 0.406, 0.848], ["The", 1.277, 1.405], ["one", 1.509, 1.765], ["number.", 1.834, 2.322], ["Damodaran's", 3.1, 3.913], ["first", 4.04, 4.354], ["rule", 4.423, 4.632], ["of", 4.656, 4.702], ["corporate", 4.772, 5.132], ["finance:", 5.166, 5.851], ["young", 6.339, 6.536], ["companies", 6.618, 7.012], ["that", 7.036, 7.152], ["aren't", 7.187, 7.372], ["making", 7.407, 7.697], ["money", 7.767, 7.941], ["shouldn't", 7.976, 8.231], ["borrow.", 8.266, 8.731], ["Anthropic,", 9.091, 9.868], ["he", 9.892, 9.973], ["says,", 10.054, 10.6], ["broke", 10.832, 11.146], ["it", 11.18, 11.227], ["by", 11.297, 11.401], ["signing", 11.482, 11.842], ["hundreds", 11.923, 12.214], ["of", 12.249, 12.307], ["billions", 12.376, 12.736], ["in", 12.783, 12.852], ["compute", 12.934, 13.27], ["commitments", 13.305, 13.816], ["without", 14.083, 14.408], ["the", 14.443, 14.512], ["earnings", 14.559, 14.849], ["to", 14.884, 14.942], ["back", 15.023, 15.232], ["them.", 15.302, 15.604], ["What", 16.033, 16.242], ["buys", 16.289, 16.532], ["time", 16.579, 16.892], ["