6, "uplifting story:"], [9.776, 11.912, "a trillion dollars in revenue a year within"], [11.947, 12.887, "about a decade,"], [13.247, 15.36, "more than any company on earth makes today."], [16.127, 18.507, "Margins of 27.5%."], [18.808, 21.525, "A cost of capital of 9.7%."], [21.874, 23.766, "And one more step most people skip:"], [23.963, 26.518, "he treated the compute contracts like debt,"], [26.773, 28.271, "worth about $500 billion,"], [28.828, 30.0, "and subtracted them."], [30.349, 33.936, "His answer was $1.475 trillion for the whole"], [33.971, 34.494, "company."], [34.97, 36.084, "Then the world changed."], [36.433, 37.884, "The midterm election,"], [37.953, 40.868, "he says, brought in a Congress more hostile"], [40.891, 42.969, "to data centers and to AI."], [43.329, 45.279, "So he raised the cost of building compute"], [45.326, 47.137, "and added a regulatory drag."], [47.625, 49.215, "That cut about $100 billion,"], [49.993, 51.862, "to roughly $1.35 trillion."], [52.292, 53.65, "Then he divided by the shares,"], [53.674, 55.38, "including a big pile of options."], [55.81, 58.677, "His answer: $77 a share."], [59.165, 62.079, "Moments later, the IPO priced at $83."], [62.439, 65.295, "His reaction: it terrifies me that I'm so"], [65.388, 66.828, "close to a banker's price."], [67.257, 69.196, "If you want the AI money story explained"], [69.22, 70.381, "like this every week,"], [70.578, 72.853, "subscribe now, so you don't miss the next"], [72.923, 73.225, "one."], [73.713, 75.396, "So what did he expect the market to"], [75.466, 76.348, "do next?"]]}, "S02": {"frames": 1763, "words": [["Part", 0.0, 0.36], ["two.", 0.406, 0.987], ["The", 1.347, 1.463], ["bankers'", 1.556, 2.055], ["game.", 2.09, 2.67], ["Damodaran", 3.1, 3.773], ["says", 3.866, 4.098], ["bankers", 4.191, 4.609], ["have", 4.679, 4.923], ["one", 5.004, 5.259], ["job", 5.306, 5.584], ["in", 5.631, 5.677], ["an", 5.724, 5.793], ["IPO:", 5.875, 6.699], ["price", 7.129, 7.558], ["it", 7.605,