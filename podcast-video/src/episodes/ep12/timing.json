 82.35], ["spent", 82.385, 82.64], ["on", 82.687, 82.768], ["computing", 82.838, 83.372], ["brought", 83.673, 83.987], ["back", 84.033, 84.196], ["40", 84.289, 84.614], ["cents.", 84.684, 85.206], ["This", 85.554, 85.845], ["year,", 85.926, 86.309], ["a", 86.402, 86.495], ["dollar", 86.576, 86.936], ["seventy-two.", 87.064, 88.016], ["People,", 88.782, 89.188], ["he", 89.212, 89.281], ["says,", 89.362, 89.885], ["should", 90.082, 90.315], ["update", 90.349, 90.651], ["their", 90.674, 90.802], ["views.", 90.849, 91.348], ["So", 91.708, 91.882], ["how", 91.952, 92.033], ["does", 92.068, 92.184], ["he", 92.219, 92.265], ["answer", 92.346, 92.613], ["Marcus?", 92.695, 93.484]], "cues": [[0.0, 0.848, "Part three."], [1.277, 2.183, "The bull case."], [2.67, 4.598, "Aaron Levie runs Box,"], [4.795, 6.908, "which sends huge amounts of business work through"], [6.954, 7.883, "AI models."], [8.313, 9.845, "He starts with a disclaimer:"], [10.205, 12.272, "he's not giving financial advice,"], [12.504, 13.932, "and he won't say what the shares are"], [13.967, 14.431, "worth."], [14.791, 16.254, "But on the market itself,"], [16.393, 17.473, "he's very bullish."], [17.833, 18.808, "His first number:"], [18.971, 22.663, "Anthropic's revenue went from $1.4 billion"], [23.023, 24.671, "in the third quarter of last year"], [25.031, 27.794, "to $17 billion this third quarter."], [28.572, 31.103, "Twelve times. He doesn't expect that again,"], [31.185, 33.297, "he says, but the direction holds."], [33.657, 34.76, "His second number:"], [35.027, 38.812, "customers spending at least $100,000 a year"], [39.381, 43.677, "grew from about 950 to about 11,900."], [44.35, 45.36, "Companies, he says,"], [45.383, 46.776, "are voting with their wallets."], [47.554, 48.982, "Why will it keep going?"], [49.342, 51.421, "Because coding was just the start."], [52.094, 54.672, "Once AI agents can use computers and write"], [54.695, 55.833, "their own software,"], [56.192, 58.77, "almost every job becomes code-adjacent:"], [59.548, 62.067, "product design, cybersecurity,"], [62.299, 63.925, "research, sales."], [64.598, 66.583, "For the first time in office work,"], [66.63, 70.415, "Levie says, output isn't limited by how fast"], [70.485, 71.448, "people can type."], [72.017, 74.455, "The only limit is how much computing power"], [74.502, 76.951, "you buy. And his favorite chart,"], [77.114, 79.041, "from Anthropic's own filing:"], [79.703, 81.619, "in early 2025,"], [81.735, 84.614, "every dollar spent on computing brought back 40"], [84.684, 86.309, "cents. This year,"], [86.402, 88.016, "a dollar seventy-two."], [88.782, 89.885, "People, he says,"], [90.082, 91.348, "should update their views."], [91.708, 93.484, "So how does he answer Marcus?"]]}, "S04": {"frames": 2987, "words": [["Part", 0.0, 0.29], ["four.", 0.337, 0.755], ["Round", 1.66, 2.009], ["two.", 2.078, 2.694], ["Kantrowitz", 3.053, 3.669], ["put", 3.715, 3.889], ["Marcus's", 3.971, 4.516], ["biggest", 4.679, 5.085], ["worries", 5.155, 5.48], ["to", 5.515, 5.584], ["Levie.", 5.666, 6.142], ["The", 6.455, 6.606], ["debt?", 6.711, 7.303], ["Levie", 7.976, 8.29], ["says", 8.324, 8.533], ["everything", 8.638, 9.067], ["depends", 9.137, 9.567], ["on", 9.613, 9.694], ["one", 9.787, 10.008], ["thing:", 10.043, 10.53], ["whether", 10.797, 11.088], ["growth", 11.169, 11.471], ["continues", 11.54, 12.167], ["at", 12.214, 12.295], ["some", 12.341, 12.562], ["level.", 12.597, 13.084], ["If", 13.444, 13.618], ["the", 13.688, 13.758], ["revenue", 13.862, 14.28], ["comes,", 14.315, 14.919], ["the", 15.023, 15.128], ["commitments", 15.197, 15.697], ["are", 15.72, 15.836], ["fine.", 15.871, 16.417], ["If", 16.776, 16.951], ["it", 17.02, 17.09], ["doesn't,", 17.136, 17.635], ["they", 17.705, 17.856], ["blow", 17.902, 18.065], ["up", 18.111, 18.181], ["the", 18.216, 18.286], ["company.", 18.32, 18.843], ["Token-maxing?", 19.748, 21.165], ["He", 21.525, 21.676], ["calls", 21.745, 22.036], ["it", 22.082, 22.152], ["a