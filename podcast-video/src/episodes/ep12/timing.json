0.0, 2.159, "Part six. The deciding number."], [2.519, 4.447, "Strip away the babies and the lemonade,"], [4.644, 6.49, "and both men are making the same bet"], [6.536, 7.872, "in opposite directions."], [8.545, 11.436, "Levie says everything depends on whether growth continues."], [11.865, 14.42, "Marcus says Anthropic has to stay a rocket."], [14.779, 16.927, "So the number to watch is next quarter's"], [16.974, 20.12, "growth. If it bounces back from 47%,"], [20.143, 21.432, "the bull case gets stronger."], [22.001, 25.124, "If it keeps sliding while those $900 billion"], [25.194, 26.459, "in commitments come due,"], [26.819, 28.003, "the bear case does."], [28.491, 30.546, "And as Ed Zitron argued in our last"], [30.616, 31.301, "episode,"], [31.788, 35.086, "anything under about $21 billion in revenue this"], [35.155, 36.734, "quarter would be a problem."], [37.303, 38.94, "This is their analysis,"], [39.033, 40.542, "not financial advice."], [41.03, 43.468, "This was two hours of Big Technology in"], [43.515, 44.258, "eight minutes."], [44.618, 46.777, "Both full episodes are linked below."], [47.207, 49.087, "And for the AI money story,"], [49.18, 50.62, "explained every week,"], [50.748, 51.92, "subscribe."]]}, "S07": {"frames": 151, "words": [["And", 0.0, 0.163], ["tell", 0.209, 0.441], ["us", 0.522, 0.604], ["in", 0.65, 0.708], ["the", 0.743, 0.813], ["comments:", 0.882, 1.486], ["which", 1.974, 2.206], ["long", 2.31, 2.612], ["podcast", 2.694, 3.332], ["should", 3.355, 3.529], ["we", 3.564, 3.634], ["break", 3.68, 3.866], ["down", 3.913, 4.122], ["next?", 4.191, 4.969]], "cues": [[0.0, 1.486, "And tell us in the comments:"], [1.974, 4.969, "which long podcast should we break down next?"]]}}