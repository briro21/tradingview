 7.546, "Gary Marcus, the scientist who spent years saying"], [7.628, 9.578, "chatbots alone would hit a wall,"], [9.845, 11.877, "actually praises Anthropic."], [12.365, 13.909, "He says its coding tool,"], [14.176, 17.96, "Claude Code, mixes language models with classic rule-based"], [17.984, 18.773, "software,"], [19.133, 21.745, "which is exactly what he argued AI needed."], [22.105, 24.056, "So the product isn't his problem."], [24.416, 25.321, "The price is."], [25.89, 28.7, "Going in, the IPO was expected to value"], [28.746, 31.498, "Anthropic at up to $1.4 trillion."], [32.275, 34.318, "Marcus wrote that the company has never made"], [34.342, 34.992, "a profit,"], [35.352, 37.569, "except for one quarter he calls anomalous and"], [37.639, 38.765, "heavily subsidized."], [39.125, 42.202, "And it carries nearly $900 billion in future"], [42.236, 42.91, "commitments."], [43.339, 45.58, "His analogy: you can make the world's best"], [45.661, 47.879, "lemonade, but if you sell it for less"], [47.902, 49.167, "than the lemons cost,"], [49.214, 50.491, "it's still a bad business."], [50.92, 52.511, "His bottom line is blunt."], [52.871, 55.146, "He wouldn't be shocked to see Anthropic go"], [55.216, 56.145, "out of business."], [57.05, 58.919, "His most likely outcome?"], [59.047, 60.185, "It gets sold,"], [60.382, 62.553, "for a lot less than a trillion dollars."], [63.041, 65.328, "If you want the AI money story explained"], [65.351, 66.35, "like this every week,"], [66.431, 68.95, "subscribe now, so you don't miss the next"], [69.02, 69.333, "one."], [69.763, 71.621, "So why is he so sure the growth"], [71.655, 72.677, "won't last?"]]}, "S02": {"frames": 2756, "words": [["Part", 0.0, 0.337], ["two.", 0.383, 0.871], ["The", 1.231, 1.382], ["trillion-pound", 1.428, 2.241], ["baby.", 2.31, 2.891], ["Marcus", 3.796, 4.191], ["has", 4.238, 4.377], ["a", 4.423, 4.458], ["favorite", 4.505, 4.807], ["joke.", 4.841, 5.317], ["A", 5.631, 5.724], ["father", 5.851, 6.165],