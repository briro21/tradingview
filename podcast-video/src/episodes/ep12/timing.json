, 87.632], ["you've", 87.667, 87.853], ["made,\"", 87.899, 88.306], ["he", 88.387, 88.457], ["told", 88.526, 88.712], ["the", 88.735, 88.805], ["host.", 88.851, 89.35], ["And", 90.024, 90.186], ["on", 90.256, 90.337], ["one", 90.43, 90.616], ["point,", 90.662, 91.011], ["Levie", 91.208, 91.498], ["conceded", 91.545, 92.032], ["outright.", 92.102, 92.706], ["Could", 93.193, 93.368], ["the", 93.402, 93.472], ["bills", 93.518, 93.809], ["come", 93.878, 94.122], ["due", 94.169, 94.424], ["before", 94.47, 94.737], ["the", 94.761, 94.83], ["industries", 94.9, 95.353], ["change?", 95.399, 96.015], ["\"Absolutely", 96.688, 97.594], ["possible,\"", 97.663, 98.441], ["he", 98.673, 98.743], ["said.", 98.824, 99.521]], "cues": [[0.0, 0.755, "Part four."], [1.66, 2.694, "Round two."], [3.053, 6.142, "Kantrowitz put Marcus's biggest worries to Levie."], [6.455, 7.303, "The debt?"], [7.976, 10.53, "Levie says everything depends on one thing:"], [10.797, 13.084, "whether growth continues at some level."], [13.444, 14.919, "If the revenue comes,"], [15.023, 16.417, "the commitments are fine."], [16.776, 17.635, "If it doesn't,"], [17.705, 18.843, "they blow up the company."], [19.748, 21.165, "Token-maxing?"], [21.525, 23.742, "He calls it a two-week fashion,"], [24.056, 27.365, "not the reason Anthropic's revenue run rate passed"], [27.411, 28.491, "$80 billion."], [29.164, 30.43, "Diminishing returns?"], [30.859, 33.46, "He says improving a model for one field,"], [33.82, 35.828, "like cybersecurity or law,"], [36.026, 38.034, "costs millions in training data,"], [38.173, 39.706, "not hundreds of billions."], [40.066, 42.388, "And each of those fields is worth trillions"], [42.423, 43.468, "of dollars of work."], [44.245, 46.358, "Cheap Chinese and open models?"], [47.264, 49.122, "Levie sees a rising tide."], [49.389, 52.001, "Companies use a top model to plan and"], [52.047, 53.707, "cheap models for the bulk work,"], [54.021, 55.577, "so they spend more on both."], [56.355, 58.119, "Marcus answers with a warning:"], [58.607, 60.221, "more than a dozen studies,"], [60.244, 63.053, "he says, show companies struggling to get a"], [63.135, 63.855, "return,"], [64.284, 66.978, "and hallucinations haven't gone away."], [67.756, 69.172, "Marcus gave ground too."], [69.532, 71.471, "He called his doubt about raising the money"], [71.552, 72.83, "his weakest argument,"], [73.189, 76.278, "as reports said the IPO was oversubscribed."], [76.765, 79.378, "He didn't dispute the tenfold revenue growth."], [79.807, 82.141, "And he agreed that the fallout from Jensen"], [82.21, 83.128, "Huang's scandal"], [83.557, 86.111, "could help Anthropic against Chinese rivals."], [86.599, 88.805, "\"The best argument you've made,\" he told the"], [88.851, 89.35, "host."], [90.024, 91.011, "And on one point,"], [91.208, 92.706, "Levie conceded outright."], [93.193, 95.353, "Could the bills come due before the industries"], [95.399, 96.015, "change?"], [96.688, 99.521, "\"Absolutely possible,\" he said."]]}, "S05": {"frames": 1122, "words": [["Part", 0.0, 0.29], ["five.", 0.337, 0.615], ["Then", 0.639, 0.755], ["the", 0.789, 0.859], ["market", 0.894, 1.149], ["voted.", 1.184, 1.637], ["On", 2.206, 2.357], ["November", 2.403, 2.74], ["19th,", 2.81, 3.437], ["Anthropic", 3.483, 4.087], ["listed", 4.168, 4.493], ["at", 4.54, 4.621], ["$83", 4.725, 5.863], ["a", 5.956, 5.991], ["share.", 6.072, 6.594], ["It", 6.954, 7.094], ["opened", 7.14, 7.396], ["around", 7.419, 7.628], ["$111", 7.663, 8.754], ["and", 8.824, 8.916], ["closed", 8.986, 9.311], ["its", 9.346, 9.439], ["first", 9.474, 9.706], ["day", 9.741, 9.88], ["near", 9.927, 10.054], ["$97.", 10.101, 11.308], ["By", 11.738, 11.912], ["Friday,", 12.005, 12.504], ["it", 12.527, 12.597], ["had", 12.643, 12.736], ["slipped", 12.806, 13.177], ["to", 13.247, 13.363], ["about", 13.456, 13.711], ["$87,", 13.758, 14.733], ["still", 14.756, 14.965], ["above", 15.012, 15.197], ["its", 15.221, 15.314], ["listing", 15.383, 15.7