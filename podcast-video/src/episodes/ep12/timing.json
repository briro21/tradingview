, ["added", 72.098, 72.411], ["more", 72.458, 72.609], ["pressure:", 72.678, 73.27], ["five", 73.758, 74.176], ["customers", 74.246, 74.814], ["make", 74.907, 75.081], ["up", 75.116, 75.198], ["19%", 75.279, 76.092], ["of", 76.184, 76.231], ["revenue,", 76.312, 76.893], ["and", 77.16, 77.392], ["some", 77.52, 77.821], ["big", 77.868, 78.042], ["ones", 78.123, 78.321], ["are", 78.355, 78.448], ["pulling", 78.472, 78.727], ["back.", 78.797, 79.261], ["Marcus's", 80.039, 80.643], ["conclusion:", 80.689, 81.641], ["Anthropic", 81.838, 82.593], ["has", 82.674, 82.872], ["to", 82.941, 82.999], ["stay", 83.069, 83.266], ["a", 83.336, 83.359], ["rocket.", 83.429, 83.975], ["Every", 84.462, 84.753], ["customer", 84.834, 85.275], ["who", 85.31, 85.414], ["pulls", 85.484, 85.774], ["back", 85.844, 86.099], ["makes", 86.192, 86.412], ["escape", 86.482, 86.842], ["velocity", 86.877, 87.434], ["harder.", 87.515, 88.049], ["That's", 88.317, 88.607], ["the", 88.653, 88.723], ["bear", 88.793, 89.036], ["case.", 89.118, 89.466], ["Now", 89.501, 89.686], ["meet", 89.814, 90.104], ["the", 90.151, 90.221], ["man", 90.302, 90.511], ["who", 90.557, 90.65], ["thinks", 90.72, 90.94], ["it's", 90.975, 91.091], ["wrong.", 91.115, 91.811]], "cues": [[0.0, 0.871, "Part two."], [1.231, 2.891, "The trillion-pound baby."], [3.796, 5.317, "Marcus has a favorite joke."], [5.631, 8.208, "A father tweets that his baby doubled its"], [8.255, 9.114, "weight in a month,"], [9.474, 11.18, "and projects that by college,"], [11.204, 13.34, "the kid will weigh a trillion pounds."], [14.245, 15.128, "Growth like that,"], [15.174, 17.67, "Marcus says, always tails off."], [18.03, 20.492, "And he thinks Anthropic's already has."], [20.84, 22.024, "In the second quarter,"], [22.279, 24.729, "revenue grew 147%,"], [24.752, 27.411, "during what he calls the token-maxing fad,"], [27.643, 29.814, "when companies told staff to use as much"], [29.907, 31.312, "AI as they could."], [31.672, 32.879, "In the third quarter,"], [33.076, 35.062, "growth was 47%."], [35.84, 37.256, "Then there's competition."], [37.453, 40.193, "Since 2023, he has argued that everyone is"], [40.263, 41.679, "building the same thing,"], [42.039, 43.908, "which means price wars."], [44.338, 46.73, "Cheaper Chinese models made that real this year,"], [46.765, 50.039, "he says. That leaves Anthropic one niche:"], [50.398, 52.163, "the very top-end models."], [52.523, 55.216, "Host Alex Kantrowitz put it this way:"], [55.785, 58.386, "if an associate professor can do the job,"], [58.746, 60.395, "why pay the full professor?"], [60.824, 62.763, "And each step up costs more."], [63.251, 65.991, "One billion to impress users this year,"], [66.42, 68.998, "Marcus warns, ten billion next year,"], [69.265, 71.006, "a hundred billion after that."], [71.436, 73.27, "Kantrowitz added more pressure:"], [73.758, 76.893, "five customers make up 19% of revenue,"], [77.16, 79.261, "and some big ones are pulling back."], [80.039, 83.975, "Marcus's conclusion: Anthropic has to stay a rocket."], [84.462, 87.434, "Every customer who pulls back makes escape velocity"], [87.515, 89.466, "harder. That's the bear case."], [89.501, 91.811, "Now meet the man who thinks it's wrong."]]}, "S03": {"frames": 2809, "words": [["Part", 0.0, 0.313], ["three.", 0.36, 0.848], ["The", 1.277, 1.382], ["bull", 1.451, 1.637], ["case.", 1.707, 2.183], ["Aaron", 2.67, 3.077], ["Levie", 3.17, 3.483], ["runs", 3.529, 3.796], ["Box,", 3.901, 4.598], ["which", 4.795, 4.981], ["sends", 5.016, 5.283], ["huge", 5.375, 5.724], ["amounts", 5.747, 6.072], ["of", 6.118, 6.165], ["business", 6.211, 6.513], ["work", 6.548, 6.711], ["through", 6.734, 6.908], ["AI", 6.954, 7.268], ["models.", 7.338, 7.883], ["He", 8.313, 8.452], ["starts", 8.487, 8.731], ["with", 8.754, 8.87], ["a", 8.905, 8.928], ["disclaimer:", 8.998, 9.845], ["he's", 10.205, 10.356], ["not", 10.403, 10.553], ["giving", 10.623, 10.89], ["financial", 10.971, 11.552], ["advice,", 11.598, 12.272]