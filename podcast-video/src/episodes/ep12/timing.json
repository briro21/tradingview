bove its listing price,"], [16.672, 18.274, "as tech stocks fell around it."], [18.704, 20.445, "The deal raised more than $80 billion,"], [20.527, 23.522, "and up to $93 billion if the underwriters"], [23.557, 24.776, "take their extra shares."], [25.263, 27.504, "So far, neither man is proven right."], [27.736, 28.503, "On the show,"], [28.549, 30.987, "both sides agreed the first day says little."], [31.347, 33.065, "The real test is time."], [33.379, 35.341, "Which brings us back to the one number"], [35.434, 37.338, "both of them agree will decide it."]]}, "S06": {"frames": 1559, "words": [["Part", 0.0, 0.337], ["six.", 0.43, 0.952], ["The", 0.998, 1.115], ["deciding", 1.161, 1.66], ["number.", 1.73, 2.159], ["Strip", 2.519, 2.833], ["away", 2.902, 3.053], ["the", 3.1, 3.17], ["babies", 3.216, 3.518], ["and", 3.553, 3.622], ["the", 3.657, 3.727], ["lemonade,", 3.762, 4.447], ["and", 4.644, 4.807], ["both", 4.899, 5.132], ["men", 5.201, 5.329], ["are", 5.364, 5.457], ["making", 5.492, 5.735], ["the", 5.782, 5.851], ["same", 5.933, 6.246], ["bet", 6.293, 6.49], ["in", 6.536, 6.594], ["opposite", 6.641, 7.024], ["directions.", 7.047, 7.872], ["Levie", 8.545, 8.847], ["says", 8.87, 9.067], ["everything", 9.137, 9.462], ["depends", 9.532, 9.95], ["on", 9.996, 10.077], ["whether", 10.124, 10.333], ["growth", 10.379, 10.6], ["continues.", 10.635, 11.436], ["Marcus", 11.865, 12.272], ["says", 12.318, 12.504], ["Anthropic", 12.585, 13.201], ["has", 13.27, 13.41], ["to", 13.456, 13.514], ["stay", 13.56, 13.746], ["a", 13.781, 13.804], ["rocket.", 13.874, 14.42], ["So", 14.779, 14.942], ["the", 15.012, 15.081], ["number", 15.128, 15.325], ["to", 15.372, 15.418], ["watch", 15.499, 15.859], ["is", 15.952, 16.126], ["next", 16.266, 16.544], ["quarter's", 16.591, 16.927], ["growth.", 16.974, 17.554], ["If", 17.868, 18.007], ["it", 18.077, 18.146], ["bounces", 18.216, 18.622], ["back", 18.692, 18.889], ["from", 18.936, 19.052], ["47%,", 19.133, 20.12], ["the", 20.143, 20.213],